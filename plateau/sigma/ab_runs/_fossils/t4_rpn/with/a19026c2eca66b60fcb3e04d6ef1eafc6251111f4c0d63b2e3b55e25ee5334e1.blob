{"code": "def rpn_eval(expr):\n    tokens = expr.split()\n    stack = []\n    ops = {\n        '+': lambda a, b: a + b,\n        '-': lambda a, b: a - b,\n        '*': lambda a, b: a * b,\n        '/': lambda a, b: a // b,\n    }\n    for tok in tokens:\n        if tok in ops:\n            if len(stack) < 2:\n                raise ValueError(\"malformed expression: too few operands\")\n            b = stack.pop()\n            a = stack.pop()\n            if tok == '/' and b == 0:\n                raise ZeroDivisionError(\"division by zero\")\n            stack.append(ops[tok](a, b))\n        else:\n            stack.append(int(tok))\n    if len(stack) != 1:\n        raise ValueError(\"malformed expression\")\n    return stack[0]", "text": "```python\ndef rpn_eval(expr):\n    tokens = expr.split()\n    stack = []\n    ops = {\n        '+': lambda a, b: a + b,\n        '-': lambda a, b: a - b,\n        '*': lambda a, b: a * b,\n        '/': lambda a, b: a // b,\n    }\n    for tok in tokens:\n        if tok in ops:\n            if len(stack) < 2:\n                raise ValueError(\"malformed expression: too few operands\")\n            b = stack.pop()\n            a = stack.pop()\n            if tok == '/' and b == 0:\n                raise ZeroDivisionError(\"division by zero\")\n            stack.append(ops[tok](a, b))\n        else:\n            stack.append(int(tok))\n    if len(stack) != 1:\n        raise ValueError(\"malformed expression\")\n    return stack[0]\n```"}