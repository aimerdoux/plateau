{"code": "def parse_ledger(text):\n    totals = {}\n    for line in text.splitlines():\n        stripped = line.strip()\n        if not stripped or stripped.startswith(\"#\"):\n            continue\n        if \":\" not in stripped:\n            continue\n        category, _, amount = stripped.partition(\":\")\n        category = category.strip()\n        amount = amount.strip()\n        try:\n            value = float(amount)\n        except ValueError:\n            continue\n        totals[category] = totals.get(category, 0.0) + value\n    return totals", "text": "```python\ndef parse_ledger(text):\n    totals = {}\n    for line in text.splitlines():\n        stripped = line.strip()\n        if not stripped or stripped.startswith(\"#\"):\n            continue\n        if \":\" not in stripped:\n            continue\n        category, _, amount = stripped.partition(\":\")\n        category = category.strip()\n        amount = amount.strip()\n        try:\n            value = float(amount)\n        except ValueError:\n            continue\n        totals[category] = totals.get(category, 0.0) + value\n    return totals\n```"}