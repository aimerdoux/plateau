{"code": "def merge_intervals(intervals):\n    if not intervals:\n        return []\n    ordered = sorted(intervals, key=lambda iv: (iv[0], iv[1]))\n    merged = [list(ordered[0])]\n    for start, end in ordered[1:]:\n        last = merged[-1]\n        if start <= last[1]:\n            if end > last[1]:\n                last[1] = end\n        else:\n            merged.append([start, end])\n    return merged\n\n\ndef complement(intervals, lo, hi):\n    if lo > hi:\n        return []\n    gaps = []\n    cursor = lo\n    for start, end in merge_intervals(intervals):\n        if end < lo or start > hi:\n            continue\n        start = max(start, lo)\n        end = min(end, hi)\n        if start > cursor:\n            gaps.append([cursor, start - 1])\n        if end >= cursor:\n            cursor = end + 1\n        if cursor > hi:\n            break\n    if cursor <= hi:\n        gaps.append([cursor, hi])\n    return gaps", "text": "```python\ndef merge_intervals(intervals):\n    if not intervals:\n        return []\n    ordered = sorted(intervals, key=lambda iv: (iv[0], iv[1]))\n    merged = [list(ordered[0])]\n    for start, end in ordered[1:]:\n        last = merged[-1]\n        if start <= last[1]:\n            if end > last[1]:\n                last[1] = end\n        else:\n            merged.append([start, end])\n    return merged\n\n\ndef complement(intervals, lo, hi):\n    if lo > hi:\n        return []\n    gaps = []\n    cursor = lo\n    for start, end in merge_intervals(intervals):\n        if end < lo or start > hi:\n            continue\n        start = max(start, lo)\n        end = min(end, hi)\n        if start > cursor:\n            gaps.append([cursor, start - 1])\n        if end >= cursor:\n            cursor = end + 1\n        if cursor > hi:\n            break\n    if cursor <= hi:\n        gaps.append([cursor, hi])\n    return gaps\n```"}