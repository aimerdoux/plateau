{"code": "def parse_csv(text):\n    if text == \"\":\n        return []\n    rows = []\n    field = []\n    row = []\n    i = 0\n    n = len(text)\n    in_quotes = False\n    started = False\n    while i < n:\n        c = text[i]\n        if in_quotes:\n            if c == '\"':\n                if i + 1 < n and text[i + 1] == '\"':\n                    field.append('\"')\n                    i += 2\n                    continue\n                in_quotes = False\n                i += 1\n                continue\n            field.append(c)\n            i += 1\n            continue\n        if c == '\"':\n            in_quotes = True\n            started = True\n            i += 1\n            continue\n        if c == ',':\n            row.append(\"\".join(field))\n            field = []\n            started = True\n            i += 1\n            continue\n        if c == '\\r':\n            if i + 1 < n and text[i + 1] == '\\n':\n                i += 1\n            row.append(\"\".join(field))\n            rows.append(row)\n            field = []\n            row = []\n            started = False\n            i += 1\n            continue\n        if c == '\\n':\n            row.append(\"\".join(field))\n            rows.append(row)\n            field = []\n            row = []\n            started = False\n            i += 1\n            continue\n        field.append(c)\n        started = True\n        i += 1\n    if started or field or row:\n        row.append(\"\".join(field))\n        rows.append(row)\n    return rows", "text": "```python\ndef parse_csv(text):\n    if text == \"\":\n        return []\n    rows = []\n    field = []\n    row = []\n    i = 0\n    n = len(text)\n    in_quotes = False\n    started = False\n    while i < n:\n        c = text[i]\n        if in_quotes:\n            if c == '\"':\n                if i + 1 < n and text[i + 1] == '\"':\n                    field.append('\"')\n                    i += 2\n                    continue\n                in_quotes = False\n                i += 1\n                continue\n            field.append(c)\n            i += 1\n            continue\n        if c == '\"':\n            in_quotes = True\n            started = True\n            i += 1\n            continue\n        if c == ',':\n            row.append(\"\".join(field))\n            field = []\n            started = True\n            i += 1\n            continue\n        if c == '\\r':\n            if i + 1 < n and text[i + 1] == '\\n':\n                i += 1\n            row.append(\"\".join(field))\n            rows.append(row)\n            field = []\n            row = []\n            started = False\n            i += 1\n            continue\n        if c == '\\n':\n            row.append(\"\".join(field))\n            rows.append(row)\n            field = []\n            row = []\n            started = False\n            i += 1\n            continue\n        field.append(c)\n        started = True\n        i += 1\n    if started or field or row:\n        row.append(\"\".join(field))\n        rows.append(row)\n    return rows\n```"}