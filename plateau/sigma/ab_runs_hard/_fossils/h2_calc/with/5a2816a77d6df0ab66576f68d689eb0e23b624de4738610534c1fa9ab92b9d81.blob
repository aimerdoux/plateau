{"code": "def calc(expr):\n    tokens = []\n    i, n = 0, len(expr)\n    while i < n:\n        c = expr[i]\n        if c.isspace():\n            i += 1\n        elif c in '+-*/^()':\n            tokens.append(c)\n            i += 1\n        elif c.isdigit() or c == '.':\n            j = i\n            dot = False\n            while j < n and (expr[j].isdigit() or expr[j] == '.'):\n                if expr[j] == '.':\n                    if dot:\n                        raise ValueError(\"malformed number\")\n                    dot = True\n                j += 1\n            tokens.append(expr[i:j])\n            i = j\n        else:\n            raise ValueError(\"invalid character: %r\" % c)\n\n    pos = 0\n\n    def peek():\n        return tokens[pos] if pos < len(tokens) else None\n\n    def advance():\n        nonlocal pos\n        tok = tokens[pos]\n        pos += 1\n        return tok\n\n    def parse_expr():\n        value = parse_term()\n        while peek() in ('+', '-'):\n            op = advance()\n            rhs = parse_term()\n            value = value + rhs if op == '+' else value - rhs\n        return value\n\n    def parse_term():\n        value = parse_factor()\n        while peek() in ('*', '/'):\n            op = advance()\n            rhs = parse_factor()\n            value = value * rhs if op == '*' else value / rhs\n        return value\n\n    def parse_factor():\n        # unary minus / plus\n        if peek() == '-':\n            advance()\n            return -parse_factor()\n        if peek() == '+':\n            advance()\n            return parse_factor()\n        base = parse_atom()\n        if peek() == '^':\n            advance()\n            exponent = parse_factor()  # right-associative\n            return base ** exponent\n        return base\n\n    def parse_atom():\n        tok = peek()\n        if tok is None:\n            raise ValueError(\"unexpected end of expression\")\n        if tok == '(':\n            advance()\n            value = parse_expr()\n            if peek() != ')':\n                raise ValueError(\"unbalanced parentheses\")\n            advance()\n            return value\n        if tok in '+-*/^)':\n            raise ValueError(\"unexpected operator: %r\" % tok)\n        advance()\n        try:\n            num = float(tok)\n        except ValueError:\n            raise ValueError(\"invalid number: %r\" % tok)\n        return int(num) if num.is_integer() else num\n\n    if not tokens:\n        raise ValueError(\"empty input\")\n\n    result = parse_expr()\n    if pos != len(tokens):\n        raise ValueError(\"trailing tokens: %r\" % tokens[pos:])\n    return result", "text": "```python\ndef calc(expr):\n    tokens = []\n    i, n = 0, len(expr)\n    while i < n:\n        c = expr[i]\n        if c.isspace():\n            i += 1\n        elif c in '+-*/^()':\n            tokens.append(c)\n            i += 1\n        elif c.isdigit() or c == '.':\n            j = i\n            dot = False\n            while j < n and (expr[j].isdigit() or expr[j] == '.'):\n                if expr[j] == '.':\n                    if dot:\n                        raise ValueError(\"malformed number\")\n                    dot = True\n                j += 1\n            tokens.append(expr[i:j])\n            i = j\n        else:\n            raise ValueError(\"invalid character: %r\" % c)\n\n    pos = 0\n\n    def peek():\n        return tokens[pos] if pos < len(tokens) else None\n\n    def advance():\n        nonlocal pos\n        tok = tokens[pos]\n        pos += 1\n        return tok\n\n    def parse_expr():\n        value = parse_term()\n        while peek() in ('+', '-'):\n            op = advance()\n            rhs = parse_term()\n            value = value + rhs if op == '+' else value - rhs\n        return value\n\n    def parse_term():\n        value = parse_factor()\n        while peek() in ('*', '/'):\n            op = advance()\n            rhs = parse_factor()\n            value = value * rhs if op == '*' else value / rhs\n        return value\n\n    def parse_factor():\n        # unary minus / plus\n        if peek() == '-':\n            advance()\n            return -parse_factor()\n        if peek() == '+':\n            advance()\n            return parse_factor()\n        base = parse_atom()\n        if peek() == '^':\n            advance()\n            exponent = parse_factor()  # right-associative\n            return base ** exponent\n        return base\n\n    def parse_atom():\n        tok = peek()\n        if tok is None:\n            raise ValueError(\"unexpected end of expression\")\n        if tok == '(':\n            advance()\n            value = parse_expr()\n            if peek() != ')':\n                raise ValueError(\"unbalanced parentheses\")\n            advance()\n            return value\n        if tok in '+-*/^)':\n            raise ValueError(\"unexpected operator: %r\" % tok)\n        advance()\n        try:\n            num = float(tok)\n        except ValueError:\n            raise ValueError(\"invalid number: %r\" % tok)\n        return int(num) if num.is_integer() else num\n\n    if not tokens:\n        raise ValueError(\"empty input\")\n\n    result = parse_expr()\n    if pos != len(tokens):\n        raise ValueError(\"trailing tokens: %r\" % tokens[pos:])\n    return result\n```"}