{"iter": 4, "reply": "# FILE: spend/__init__.py\n```python\n\"\"\"spend \u2014 a small but real personal-expense-tracker CLI.\n\nBuilt feature-by-feature where early decisions constrain later ones. The\nload-bearing decision is the storage schema (see ``spend.models``): every\nentry has a stable integer ``id`` plus ``category`` and a ``tags`` *list*.\nThat list \u2014 rather than a packed string \u2014 is what makes tag filtering,\nCSV round-tripping, and the v1->v2 migration all behave.\n\nThe on-disk persistence layer lives in :mod:`spend.storage` (also reachable\nunder the historical alias ``spend.store``).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\n\nfrom .errors import (\n    SpendError,\n    ValidationError,\n    EntryNotFoundError,\n    NothingToUndoError,\n    ConfigError,\n)\nfrom .money import (\n    round_money,\n    to_cents,\n    from_cents,\n    parse_money,\n    format_money,\n    total,\n)\nfrom .models import (\n    Entry,\n    SCHEMA_VERSION,\n    DEFAULT_CATEGORY,\n    parse_date,\n    normalize_date,\n    today_iso,\n)\nfrom .config import (\n    Config,\n    load_config,\n    save_config,\n    default_config_path,\n    default_data_path,\n)\nfrom .migrations import migrate\nfrom .tracker import Tracker\nfrom .csvexport import export_csv, read_csv, TAG_SEPARATOR\n\nfrom . import errors\nfrom . import money\nfrom . import models\nfrom . import config\nfrom . import migrations\nfrom . import tracker\nfrom . import storage\nfrom . import csvexport\nfrom . import core\n\n# Historical / alternate-spelling aliases so callers can import the persistence\n# and CSV layers under either name without surprises. We register the alias in\n# ``sys.modules`` too, so ``import spend.store`` works as a submodule import and\n# not merely as an attribute lookup.\nstore = storage\ncsv_export = csvexport\nsys.modules[__name__ + \".store\"] = storage\nsys.modules[__name__ + \".csv_export\"] = csvexport\n\n__version__ = \"1.0.0\"\n\n__all__ = [\n    \"Entry\",\n    \"Tracker\",\n    \"Config\",\n    \"SCHEMA_VERSION\",\n    \"DEFAULT_CATEGORY\",\n    \"parse_date\",\n    \"normalize_date\",\n    \"today_iso\",\n    \"load_config\",\n    \"save_config\",\n    \"default_config_path\",\n    \"default_data_path\",\n    \"migrate\",\n    \"export_csv\",\n    \"read_csv\",\n    \"TAG_SEPARATOR\",\n    \"money\",\n    \"round_money\",\n    \"to_cents\",\n    \"from_cents\",\n    \"parse_money\",\n    \"format_money\",\n    \"total\",\n    \"storage\",\n    \"store\",\n    \"csvexport\",\n    \"csv_export\",\n    \"core\",\n    \"errors\",\n    \"models\",\n    \"config\",\n    \"migrations\",\n    \"tracker\",\n    \"SpendError\",\n    \"ValidationError\",\n    \"EntryNotFoundError\",\n    \"NothingToUndoError\",\n    \"ConfigError\",\n    \"__version__\",\n]\n```\n\n# FILE: spend/errors.py\n```python\n\"\"\"Exception hierarchy for the spend package.\n\nA single base class (``SpendError``) lets callers and the CLI catch every\ndomain error in one place while still distinguishing specific failures.\n\"\"\"\n\n\nclass SpendError(Exception):\n    \"\"\"Base class for all errors raised by this package.\"\"\"\n\n\nclass ValidationError(SpendError):\n    \"\"\"An entry, config value, or argument failed validation.\"\"\"\n\n\nclass EntryNotFoundError(SpendError):\n    \"\"\"No entry with the requested id exists.\"\"\"\n\n\nclass NothingToUndoError(SpendError):\n    \"\"\"``undo`` was called but the undo stack is empty.\"\"\"\n\n\nclass ConfigError(SpendError):\n    \"\"\"The config file could not be read or contained bad values.\"\"\"\n```\n\n# FILE: spend/money.py\n```python\n\"\"\"Money helpers.\n\nAmounts are stored as floats for JSON friendliness, but money is fundamentally\na cent-precision quantity. Summing floats directly accumulates error; these\nhelpers route arithmetic through integer cents and round half-up at the cent\nboundary so summary stats (turn 9) and CSV round-trips (turn 10) stay exact.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport math\nfrom typing import Iterable\n\nfrom .errors import ValidationError\n\nCENTS = 100\n\n\ndef round_money(amount) -> float:\n    \"\"\"Round ``amount`` to cent precision (half-up) and return a float.\"\"\"\n    try:\n        a = float(amount)\n    except (TypeError, ValueError) as exc:\n        raise ValidationError(f\"amount must be numeric, got {amount!r}\") from exc\n    if not math.isfinite(a):\n        raise ValidationError(\"amount must be finite\")\n    cents = math.floor(abs(a) * CENTS + 0.5)\n    result = cents / float(CENTS)\n    return -result if a < 0 else result\n\n\ndef to_cents(amount) -> int:\n    \"\"\"Return ``amount`` as an integer number of cents.\"\"\"\n    a = round_money(amount)\n    return int(round(a * CENTS))\n\n\ndef from_cents(cents) -> float:\n    \"\"\"Build a float amount from an integer number of cents.\"\"\"\n    return int(cents) / float(CENTS)\n\n\ndef parse_money(text) -> float:\n    \"\"\"Parse a user-supplied money string (``$``/commas tolerated).\"\"\"\n    if isinstance(text, bool):\n        raise ValidationError(\"amount must be numeric, got a bool\")\n    if isinstance(text, (int, float)):\n        return round_money(text)\n    s = str(text).strip().replace(\",\", \"\").replace(\"$\", \"\")\n    if not s:\n        raise ValidationError(\"empty money value\")\n    try:\n        return round_money(float(s))\n    except ValueError as exc:\n        raise ValidationError(f\"could not parse money {text!r}\") from exc\n\n\ndef format_money(amount, symbol: str = \"$\") -> str:\n    \"\"\"Format ``amount`` for display, e.g. ``$1,234.50`` / ``-$3.00``.\"\"\"\n    a = round_money(amount)\n    if a < 0:\n        return f\"-{symbol}{abs(a):,.2f}\"\n    return f\"{symbol}{a:,.2f}\"\n\n\ndef total(amounts: Iterable) -> float:\n    \"\"\"Sum a sequence of amounts exactly, via integer cents.\"\"\"\n    cents = 0\n    for a in amounts:\n        cents += to_cents(a)\n    return from_cents(cents)\n```\n\n# FILE: spend/models.py\n```python\n\"\"\"Turn 1 \u2014 the load-bearing decision: the data model / storage schema.\n\nAn :class:`Entry` is the atomic record. The fields chosen here ripple through\nevery later feature:\n\n* ``id``        \u2014 a stable integer identity. *Required* so that edit (turn 5),\n                  delete (turn 6) and undo (turn 12) can refer to a specific\n                  record across process restarts. Never reused.\n* ``amount``    \u2014 a float (money). Summary stats (turn 9) round to cents.\n* ``description`` \u2014 free text.\n* ``date``      \u2014 stored canonically as ISO ``YYYY-MM-DD`` regardless of the\n                  user's display ``date_format`` (turn 11). Canonical storage is\n                  what makes date-range queries (turn 8) and migration (turn 13)\n                  simple and unambiguous.\n* ``category``  \u2014 single string (turn 7). Defaults via config (turn 11).\n* ``tags``      \u2014 a *list* of strings (turn 7).\n\nWhy ``tags`` is a list and not a packed ``\"a,b\"`` string is the crux of turn 15:\na packed string can't represent a tag that itself contains the packing\ndelimiter, and it forces every consumer (filter, CSV export, migration) to agree\non splitting rules. A real list defers the serialization choice to the boundary\n(the CSV writer) where it can be quoted/escaped correctly.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime\nimport math\nfrom dataclasses import dataclass, field\nfrom typing import Any, Dict, List\n\nfrom .errors import ValidationError\n\n# On-disk container format version. v1 was a bare JSON list of entry dicts with\n# no category/tags; v2 is a dict wrapper carrying next_id + entries.\nSCHEMA_VERSION = 2\n\nDEFAULT_CATEGORY = \"uncategorized\"\n\n\ndef today_iso() -> str:\n    \"\"\"Return today's date as an ISO ``YYYY-MM-DD`` string.\"\"\"\n    return datetime.date.today().isoformat()\n\n\ndef normalize_date(value: Any) -> str:\n    \"\"\"Coerce ``value`` to a canonical ISO date string, validating it.\"\"\"\n    if value is None:\n        return today_iso()\n    if isinstance(value, datetime.datetime):\n        return value.date().isoformat()\n    if isinstance(value, datetime.date):\n        return value.isoformat()\n    s = str(value).strip()\n    try:\n        return datetime.date.fromisoformat(s).isoformat()\n    except ValueError as exc:\n        raise ValidationError(\n            f\"date must be ISO YYYY-MM-DD, got {value!r}\"\n        ) from exc\n\n\ndef parse_date(value: Any, fmt: str = \"%Y-%m-%d\") -> str:\n    \"\"\"Parse a user-supplied date in ``fmt`` (or ISO) into canonical ISO.\"\"\"\n    if value is None:\n        return today_iso()\n    if isinstance(value, (datetime.date, datetime.datetime)):\n        return normalize_date(value)\n    s = str(value).strip()\n    try:\n        return datetime.date.fromisoformat(s).isoformat()\n    except ValueError:\n        pass\n    try:\n        return datetime.datetime.strptime(s, fmt).date().isoformat()\n    except ValueError as exc:\n        raise ValidationError(\n            f\"could not parse date {value!r} with format {fmt!r} or ISO\"\n        ) from exc\n\n\n@dataclass\nclass Entry:\n    \"\"\"A single tracked expense.\"\"\"\n\n    id: int\n    amount: float\n    description: str = \"\"\n    date: str = field(default_factory=today_iso)\n    category: str = DEFAULT_CATEGORY\n    tags: List[str] = field(default_factory=list)\n\n    def __post_init__(self) -> None:\n        if self.tags is None:\n            self.tags = []\n        elif not isinstance(self.tags, list):\n            self.tags = list(self.tags)\n\n    def validate(self) -> \"Entry\":\n        \"\"\"Raise :class:`ValidationError` if malformed; returns self.\"\"\"\n        if not isinstance(self.id, int) or isinstance(self.id, bool):\n            raise ValidationError(f\"id must be an int, got {self.id!r}\")\n        try:\n            amount = float(self.amount)\n        except (TypeError, ValueError) as exc:\n            raise ValidationError(\n                f\"amount must be numeric, got {self.amount!r}\"\n            ) from exc\n        if not math.isfinite(amount):\n            raise ValidationError(\"amount must be finite\")\n        self.amount = amount\n        self.date = normalize_date(self.date)\n        if not isinstance(self.tags, (list, tuple)):\n            raise ValidationError(\"tags must be a list\")\n        self.tags = [str(t) for t in self.tags]\n        self.category = str(self.category) if self.category else DEFAULT_CATEGORY\n        self.description = \"\" if self.description is None else str(self.description)\n        return self\n\n    def has_tag(self, tag: str) -> bool:\n        return str(tag) in self.tags\n\n    def copy(self) -> \"Entry\":\n        return Entry(\n            id=self.id,\n            amount=self.amount,\n            description=self.description,\n            date=self.date,\n            category=self.category,\n            tags=list(self.tags),\n        )\n\n    def to_dict(self) -> Dict[str, Any]:\n        \"\"\"Serialize to a JSON-safe dict with a stable field order.\"\"\"\n        return {\n            \"id\": self.id,\n            \"date\": self.date,\n            \"amount\": self.amount,\n            \"category\": self.category,\n            \"tags\": list(self.tags),\n            \"description\": self.description,\n        }\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"Entry\":\n        \"\"\"Build an Entry from a stored dict.\n\n        Tolerant of the turn-1 (v1) shape: ``category`` and ``tags`` may be\n        absent or null and are defaulted. This additive tolerance is what lets\n        turn-7's schema extension load older data without a hard migration.\n        \"\"\"\n        if not isinstance(data, dict):\n            raise ValidationError(f\"entry data must be a dict, got {data!r}\")\n        if \"id\" not in data or data[\"id\"] is None:\n            raise ValidationError(\"entry data missing required 'id'\")\n        return cls(\n            id=int(data[\"id\"]),\n            amount=data.get(\"amount\", 0.0),\n            description=data.get(\"description\", \"\") or \"\",\n            date=data.get(\"date\") or today_iso(),\n            category=data.get(\"category\") or DEFAULT_CATEGORY,\n            tags=list(data.get(\"tags\") or []),\n        ).validate()\n```\n\n# FILE: spend/migrations.py\n```python\n\"\"\"Turn 13 \u2014 schema migration.\n\nThe migration is *idempotent* and *format-detecting*. It accepts any of:\n\n* ``None``                      \u2014 a missing file \u2192 an empty v2 store.\n* a bare ``list`` of dicts      \u2014 the turn-1 (v1) on-disk shape, which had no\n                                  ``category``/``tags`` and possibly no ids.\n* a ``dict`` wrapper            \u2014 a v2 store (``{version, next_id, entries}``),\n                                  or a partial wrapper to be normalized.\n\nIt always returns a normalized v2 dict whose ``entries`` are plain dicts (not\n:class:`~spend.models.Entry`) so the migration stays a pure data transform that\ncan be unit-tested without the model layer.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Any, Dict, List\n\nfrom .errors import ValidationError\nfrom .models import SCHEMA_VERSION, DEFAULT_CATEGORY, normalize_date\n\n\ndef _next_id(entry_dicts: List[Dict[str, Any]]) -> int:\n    ids = [int(e[\"id\"]) for e in entry_dicts if e.get(\"id\") is not None]\n    return (max(ids) + 1) if ids else 1\n\n\ndef _upgrade_entry_dict(data: Dict[str, Any], fallback_id: int) -> Dict[str, Any]:\n    \"\"\"Bring a single entry dict up to the v2 shape (additive defaults).\"\"\"\n    out = dict(data)\n    if out.get(\"id\") is None:\n        out[\"id\"] = fallback_id\n    else:\n        out[\"id\"] = int(out[\"id\"])\n    out[\"category\"] = out.get(\"category\") or DEFAULT_CATEGORY\n    tags = out.get(\"tags\")\n    out[\"tags\"] = list(tags) if tags else []\n    out[\"amount\"] = out.get(\"amount\", 0.0)\n    out[\"description\"] = out.get(\"description\", \"\") or \"\"\n    out[\"date\"] = normalize_date(out.get(\"date\"))\n    return out\n\n\ndef _upgrade_entries(raw_entries: List[Any]) -> List[Dict[str, Any]]:\n    upgraded: List[Dict[str, Any]] = []\n    # Assign ids to any id-less v1 rows from a counter that stays clear of\n    # whatever explicit ids already exist.\n    explicit = [\n        int(e[\"id\"])\n        for e in raw_entries\n        if isinstance(e, dict) and e.get(\"id\") is not None\n    ]\n    counter = (max(explicit) + 1) if explicit else 1\n    for e in raw_entries:\n        if not isinstance(e, dict):\n            raise ValidationError(f\"entry must be a dict, got {e!r}\")\n        if e.get(\"id\") is None:\n            upgraded.append(_upgrade_entry_dict(e, counter))\n            counter += 1\n        else:\n            upgraded.append(_upgrade_entry_dict(e, int(e[\"id\"])))\n    return upgraded\n\n\ndef migrate(raw: Any) -> Dict[str, Any]:\n    \"\"\"Normalize ``raw`` (any supported on-disk shape) into a v2 store dict.\"\"\"\n    if raw is None:\n        return {\"version\": SCHEMA_VERSION, \"next_id\": 1, \"entries\": []}\n\n    if isinstance(raw, list):  # turn-1 v1 format: a bare list of entries.\n        entries = _upgrade_entries(raw)\n        return {\n            \"version\": SCHEMA_VERSION,\n            \"next_id\": _next_id(entries),\n            \"entries\": entries,\n        }\n\n    if isinstance(raw, dict):\n        entries = _upgrade_entries(list(raw.get(\"entries\", [])))\n        next_id = raw.get(\"next_id\")\n        if not isinstance(next_id, int) or isinstance(next_id, bool) or next_id < 1:\n            next_id = _next_id(entries)\n        # Guarantee next_id never collides with an existing id.\n        next_id = max(next_id, _next_id(entries))\n        return {\n            \"version\": SCHEMA_VERSION,\n            \"next_id\": next_id,\n            \"entries\": entries,\n        }\n\n    raise ValidationError(f\"unrecognized storage format: {type(raw).__name__}\")\n```\n\n# FILE: spend/storage.py\n```python\n\"\"\"Turn 4 \u2014 persistence to disk (honoring the turn-1 schema).\n\nThe on-disk format is JSON. A v2 store is a dict wrapper::\n\n    {\"version\": 2, \"next_id\": 5, \"entries\": [ {entry dicts...} ]}\n\n:func:`load` reads whatever is on disk, runs it through the turn-13\n:func:`~spend.migrations.migrate` transform, and hands back live\n:class:`~spend.models.Entry` objects plus the ``next_id`` counter. :func:`save`\ngoes the other way. Reading always upgrades, so a file written under the turn-1\nv1 format (a bare list, no category/tags) loads transparently.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nfrom typing import Any, Dict, List\n\nfrom .errors import SpendError\nfrom .models import Entry, SCHEMA_VERSION\nfrom .migrations import migrate, _next_id\n\n__all__ = [\n    \"load\",\n    \"save\",\n    \"load_entries\",\n    \"save_entries\",\n    \"read_raw\",\n    \"write_payload\",\n    \"dumps\",\n    \"loads\",\n]\n\n\ndef read_raw(path: str) -> Any:\n    \"\"\"Read and JSON-decode ``path``; return ``None`` if it does not exist.\"\"\"\n    if not path or not os.path.exists(path):\n        return None\n    with open(path, \"r\", encoding=\"utf-8\") as fh:\n        text = fh.read()\n    if not text.strip():\n        return None\n    try:\n        return json.loads(text)\n    except (ValueError, TypeError) as exc:\n        raise SpendError(f\"could not parse store at {path!r}: {exc}\") from exc\n\n\ndef loads(text: str) -> Dict[str, Any]:\n    \"\"\"Parse a JSON string into a normalized v2 store of Entry objects.\"\"\"\n    raw = json.loads(text) if text and text.strip() else None\n    return _hydrate(migrate(raw))\n\n\ndef _hydrate(state: Dict[str, Any]) -> Dict[str, Any]:\n    entries = [Entry.from_dict(d) for d in state[\"entries\"]]\n    next_id = max(int(state.get(\"next_id\", 1)), _next_id([e.to_dict() for e in entries]))\n    return {\"version\": SCHEMA_VERSION, \"next_id\": next_id, \"entries\": entries}\n\n\ndef load(path: str) -> Dict[str, Any]:\n    \"\"\"Load ``path`` into ``{\"version\", \"next_id\", \"entries\": [Entry, ...]}``.\"\"\"\n    return _hydrate(migrate(read_raw(path)))\n\n\ndef load_entries(path: str) -> List[Entry]:\n    \"\"\"Convenience: return just the list of :class:`Entry` from ``path``.\"\"\"\n    return load(path)[\"entries\"]\n\n\ndef _to_payload(entries, next_id=None) -> Dict[str, Any]:\n    dicts = []\n    for e in entries:\n        dicts.append(e.to_dict() if isinstance(e, Entry) else dict(e))\n    if next_id is None:\n        next_id = _next_id(dicts)\n    next_id = max(int(next_id), _next_id(dicts))\n    return {\"version\": SCHEMA_VERSION, \"next_id\": next_id, \"entries\": dicts}\n\n\ndef dumps(entries, next_id=None) -> str:\n    \"\"\"Serialize ``entries`` to a JSON string in the v2 store format.\"\"\"\n    return json.dumps(_to_payload(entries, next_id), indent=2, sort_keys=False)\n\n\ndef write_payload(path: str, payload: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Write an already-built v2 payload dict to ``path`` atomically.\"\"\"\n    directory = os.path.dirname(os.path.abspath(path))\n    if directory and not os.path.exists(directory):\n        os.makedirs(directory, exist_ok=True)\n    tmp = path + \".tmp\"\n    with open(tmp, \"w\", encoding=\"utf-8\") as fh:\n        json.dump(payload, fh, indent=2, sort_keys=False)\n    os.replace(tmp, path)\n    return payload\n\n\ndef save(path: str, entries, next_id=None) -> Dict[str, Any]:\n    \"\"\"Persist ``entries`` (Entry objects or dicts) to ``path``.\"\"\"\n    return write_payload(path, _to_payload(entries, next_id))\n\n\ndef save_entries(path: str, entries, next_id=None) -> Dict[str, Any]:\n    \"\"\"Alias for :func:`save` for symmetry with :func:`load_entries`.\"\"\"\n    return save(path, entries, next_id)\n```\n\n# FILE: spend/config.py\n```python\n\"\"\"Turn 11 \u2014 a config file (default category, date format).\n\nConfig is small and forgiving: an unknown or missing file yields defaults\nrather than an error, and unknown keys are ignored. The two load-bearing\nsettings are ``default_category`` (used by :meth:`Tracker.add` when the caller\nomits one) and ``date_format`` (used to parse user-supplied dates before they\nare canonicalized to ISO for storage).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nfrom dataclasses import dataclass, asdict\nfrom typing import Any, Dict\n\nfrom .errors import ConfigError\nfrom .models import DEFAULT_CATEGORY\n\n\ndef default_config_path() -> str:\n    return os.path.join(os.path.expanduser(\"~\"), \".spend\", \"config.json\")\n\n\ndef default_data_path() -> str:\n    return os.path.join(os.path.expanduser(\"~\"), \".spend\", \"data.json\")\n\n\n@dataclass\nclass Config:\n    \"\"\"User-tunable settings.\"\"\"\n\n    default_category: str = DEFAULT_CATEGORY\n    date_format: str = \"%Y-%m-%d\"\n    currency: str = \"$\"\n    data_path: str = \"\"\n\n    def to_dict(self) -> Dict[str, Any]:\n        return asdict(self)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, Any]) -> \"Config\":\n        if data is None:\n            return cls()\n        if not isinstance(data, dict):\n            raise ConfigError(f\"config must be a dict, got {data!r}\")\n        known = {f for f in cls().to_dict()}\n        kwargs = {k: v for k, v in data.items() if k in known}\n        cfg = cls(**kwargs)\n        if not cfg.default_category:\n            cfg.default_category = DEFAULT_CATEGORY\n        if not cfg.date_format:\n            cfg.date_format = \"%Y-%m-%d\"\n        return cfg\n\n\ndef load_config(path: str = None) -> Config:\n    \"\"\"Load a :class:`Config` from ``path`` (defaults if missing).\"\"\"\n    p = path or default_config_path()\n    if not os.path.exists(p):\n        return Config()\n    try:\n        with open(p, \"r\", encoding=\"utf-8\") as fh:\n            text = fh.read()\n        data = json.loads(text) if text.strip() else {}\n    except (ValueError, OSError) as exc:\n        raise ConfigError(f\"could not read config at {p!r}: {exc}\") from exc\n    return Config.from_dict(data)\n\n\ndef save_config(config: Config, path: str = None) -> str:\n    \"\"\"Write ``config`` to ``path`` and return the path used.\"\"\"\n    p = path or default_config_path()\n    if isinstance(config, Config):\n        data = config.to_dict()\n    elif isinstance(config, dict):\n        data = Config.from_dict(config).to_dict()\n    else:\n        raise ConfigError(f\"cannot save config of type {type(config).__name__}\")\n    directory = os.path.dirname(os.path.abspath(p))\n    if directory and not os.path.exists(directory):\n        os.makedirs(directory, exist_ok=True)\n    with open(p, \"w\", encoding=\"utf-8\") as fh:\n        json.dump(data, fh, indent=2, sort_keys=False)\n    return p\n```\n\n# FILE: spend/csvexport.py\n```python\n\"\"\"Turn 10 \u2014 export to CSV, and the turn-15 bugfix.\n\nCSV is a flat, comma-delimited format with no native notion of a list. The\nturn-7 decision to keep ``tags`` as a real list (not a packed ``\"a,b\"`` string)\nis exactly what makes correct CSV serialization possible: we own the boundary,\nso we choose an encoding that round-trips *any* tag content.\n\nThe turn-15 bug: an early version joined tags with a separator and split on it\nwhen reading back \u2014 which silently corrupts a tag that itself contains the\nseparator (or a comma, which CSV would re-quote). The fix is to JSON-encode the\ntag list into the cell. ``read_csv`` still accepts the old separator-joined form\nso historical exports keep loading, but new exports are loss-free.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport io\nimport json\nfrom typing import Any, List\n\nfrom .models import Entry\nfrom .money import round_money\n\nTAG_SEPARATOR = \";\"\nFIELDNAMES = [\"id\", \"date\", \"amount\", \"category\", \"tags\", \"description\"]\n\n\ndef _encode_tags(tags) -> str:\n    \"\"\"Loss-free tag-list encoding for a single CSV cell (turn-15 fix).\"\"\"\n    return json.dumps(list(tags or []))\n\n\ndef _decode_tags(cell: Any) -> List[str]:\n    \"\"\"Decode a tags cell, tolerating both the JSON and legacy joined forms.\"\"\"\n    if cell is None:\n        return []\n    if isinstance(cell, list):\n        return [str(t) for t in cell]\n    s = str(cell).strip()\n    if not s:\n        return []\n    try:\n        parsed = json.loads(s)\n        if isinstance(parsed, list):\n            return [str(t) for t in parsed]\n    except (ValueError, TypeError):\n        pass\n    # Legacy fallback: separator-joined string.\n    return [part for part in s.split(TAG_SEPARATOR) if part != \"\"]\n\n\ndef export_csv(entries, target) -> Any:\n    \"\"\"Write ``entries`` as CSV to ``target`` (a path or a file-like object).\"\"\"\n    rows = []\n    for e in entries:\n        d = e.to_dict() if isinstance(e, Entry) else dict(e)\n        rows.append(\n            {\n                \"id\": d[\"id\"],\n                \"date\": d[\"date\"],\n                \"amount\": f\"{round_money(d['amount']):.2f}\",\n                \"category\": d.get(\"category\", \"\"),\n                \"tags\": _encode_tags(d.get(\"tags\")),\n                \"description\": d.get(\"description\", \"\"),\n            }\n        )\n\n    def _write(fh):\n        writer = csv.DictWriter(fh, fieldnames=FIELDNAMES)\n        writer.writeheader()\n        for row in rows:\n            writer.writerow(row)\n\n    if hasattr(target, \"write\"):\n        _write(target)\n        return target\n\n    with open(target, \"w\", encoding=\"utf-8\", newline=\"\") as fh:\n        _write(fh)\n    return target\n\n\ndef read_csv(source) -> List[Entry]:\n    \"\"\"Read CSV from ``source`` (a path or file-like) into Entry objects.\"\"\"\n    if hasattr(source, \"read\"):\n        text = source.read()\n    else:\n        with open(source, \"r\", encoding=\"utf-8\", newline=\"\") as fh:\n            text = fh.read()\n\n    entries: List[Entry] = []\n    reader = csv.DictReader(io.StringIO(text))\n    for row in reader:\n        if row.get(\"id\") in (None, \"\"):\n            continue\n        entries.append(\n            Entry(\n                id=int(row[\"id\"]),\n                amount=round_money(row.get(\"amount\", 0.0) or 0.0),\n                description=row.get(\"description\", \"\") or \"\",\n                date=row.get(\"date\") or None,\n                category=row.get(\"category\") or None,\n                tags=_decode_tags(row.get(\"tags\")),\n            ).validate()\n        )\n    return entries\n```\n\n# FILE: spend/tracker.py\n```python\n\"\"\"The Tracker \u2014 the live, in-memory model that ties every turn together.\n\nIt owns the entry list and the ``next_id`` counter, exposes the user-facing\noperations (add / list / edit / delete / query / summary), persists through\n:mod:`spend.storage`, and implements undo (turn 12).\n\nUndo model: every mutating operation snapshots the full state (deep copies of\nthe entries plus ``next_id``) onto a stack *before* mutating. ``undo`` restores\nthe most recent snapshot. This deliberately \"understands\" the turn-5 edit and\nturn-6 delete mutation model by treating all of them uniformly as state\ntransitions, so a single mechanism inverts any of them correctly.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom typing import Callable, Dict, List, Optional\n\nfrom .errors import EntryNotFoundError, NothingToUndoError, ValidationError\nfrom .models import Entry, DEFAULT_CATEGORY, parse_date, today_iso\nfrom .config import Config\nfrom .money import parse_money, total as money_total, round_money\nfrom . import storage\n\n\nclass Tracker:\n    def __init__(self, entries=None, next_id: int = 1, config: Config = None,\n                 path: str = None):\n        self._entries: List[Entry] = list(entries) if entries else []\n        self._config: Config = config or Config()\n        self._path: Optional[str] = path\n        self._undo: List[tuple] = []\n        seed = max([e.id for e in self._entries], default=0) + 1\n        self._next_id = max(int(next_id), seed)\n\n    # ----- properties ---------------------------------------------------\n    @property\n    def entries(self) -> List[Entry]:\n        return list(self._entries)\n\n    @property\n    def next_id(self) -> int:\n        return self._next_id\n\n    @property\n    def config(self) -> Config:\n        return self._config\n\n    def __len__(self) -> int:\n        return len(self._entries)\n\n    def __iter__(self):\n        return iter(self._entries)\n\n    # ----- undo plumbing ------------------------------------------------\n    def _snapshot(self):\n        return ([e.copy() for e in self._entries], self._next_id)\n\n    def _push_undo(self, label: str) -> None:\n        self._undo.append((label, self._snapshot()))\n\n    def undo(self) -> str:\n        if not self._undo:\n            raise NothingToUndoError(\"nothing to undo\")\n        label, (entries, next_id) = self._undo.pop()\n        self._entries = entries\n        self._next_id = next_id\n        return label\n\n    # ----- turn 2: add --------------------------------------------------\n    def add(self, amount, description: str = \"\", date=None, category=None,\n            tags=None) -> Entry:\n        amt = parse_money(amount)\n        cat = category if category not in (None, \"\") else self._config.default_category\n        if date is None:\n            d = today_iso()\n        else:\n            d = parse_date(date, self._config.date_format)\n        entry = Entry(\n            id=self._next_id,\n            amount=amt,\n            description=description or \"\",\n            date=d,\n            category=cat or DEFAULT_CATEGORY,\n            tags=list(tags or []),\n        ).validate()\n        self._push_undo(\"add\")\n        self._entries.append(entry)\n        self._next_id += 1\n        return entry\n\n    # ----- turn 3 / 8: list & filter -----------------------------------\n    def get(self, entry_id: int) -> Entry:\n        for e in self._entries:\n            if e.id == entry_id:\n                return e\n        raise EntryNotFoundError(f\"no entry with id {entry_id}\")\n\n    def list(self, category=None, tag=None, start=None, end=None,\n             text=None) -> List[Entry]:\n        result = list(self._entries)\n        if category is not None:\n            result = [e for e in result if e.category == category]\n        if tag is not None:\n            result = [e for e in result if e.has_tag(tag)]\n        if start is not None:\n            s = parse_date(start, self._config.date_format)\n            result = [e for e in result if e.date >= s]\n        if end is not None:\n            en = parse_date(end, self._config.date_format)\n            result = [e for e in result if e.date <= en]\n        if text:\n            needle = str(text).lower()\n            result = [e for e in result if needle in e.description.lower()]\n        return sorted(result, key=lambda e: (e.date, e.id))\n\n    # Alias used by some callers.\n    def all(self) -> List[Entry]:\n        return self.list()\n\n    def between(self, start=None, end=None) -> List[Entry]:\n        \"\"\"Turn 8 \u2014 date-range query (inclusive on both ends).\"\"\"\n        return self.list(start=start, end=end)\n\n    def query(self, start=None, end=None, category=None, tag=None,\n              text=None) -> List[Entry]:\n        return self.list(category=category, tag=tag, start=start, end=end,\n                         text=text)\n\n    # ----- turn 5: edit -------------------------------------------------\n    def edit(self, entry_id: int, **changes) -> Entry:\n        entry = self.get(entry_id)\n        allowed = {\"amount\", \"description\", \"date\", \"category\", \"tags\"}\n        unknown = set(changes) - allowed\n        if unknown:\n            raise ValidationError(f\"cannot edit fields: {sorted(unknown)}\")\n        self._push_undo(\"edit\")\n        if \"amount\" in changes:\n            entry.amount = parse_money(changes[\"amount\"])\n        if \"description\" in changes:\n            entry.description = str(changes[\"description\"] or \"\")\n        if \"date\" in changes:\n            entry.date = parse_date(changes[\"date\"], self._config.date_format)\n        if \"category\" in changes:\n            entry.category = changes[\"category\"] or DEFAULT_CATEGORY\n        if \"tags\" in changes:\n            entry.tags = list(changes[\"tags\"] or [])\n        entry.validate()\n        return entry\n\n    # ----- turn 6: delete with confirmation -----------------------------\n    def delete(self, entry_id: int, confirm=True) -> Optional[Entry]:\n        entry = self.get(entry_id)\n        if callable(confirm):\n            ok = bool(confirm(entry))\n        else:\n            ok = bool(confirm)\n        if not ok:\n            return None\n        self._push_undo(\"delete\")\n        self._entries = [e for e in self._entries if e.id != entry_id]\n        return entry\n\n    # ----- turn 7: categories / tags helpers ----------------------------\n    def categories(self) -> List[str]:\n        return sorted({e.category for e in self._entries})\n\n    def tags(self) -> List[str]:\n        seen = set()\n        for e in self._entries:\n            seen.update(e.tags)\n        return sorted(seen)\n\n    def add_tag(self, entry_id: int, tag: str) -> Entry:\n        entry = self.get(entry_id)\n        if entry.has_tag(tag):\n            return entry\n        self._push_undo(\"add_tag\")\n        entry.tags.append(str(tag))\n        return entry\n\n    def remove_tag(self, entry_id: int, tag: str) -> Entry:\n        entry = self.get(entry_id)\n        if not entry.has_tag(tag):\n            return entry\n        self._push_undo(\"remove_tag\")\n        entry.tags = [t for t in entry.tags if t != str(tag)]\n        return entry\n\n    # ----- turn 9: summary stats ----------------------------------------\n    def total(self, entries=None) -> float:\n        items = self._entries if entries is None else entries\n        return money_total(e.amount for e in items)\n\n    def summary(self) -> Dict[str, object]:\n        amounts = [e.amount for e in self._entries]\n        count = len(amounts)\n        grand = money_total(amounts)\n        by_category: Dict[str, float] = {}\n        for e in self._entries:\n            by_category[e.category] = round_money(\n                by_category.get(e.category, 0.0) + e.amount\n            )\n        by_tag: Dict[str, float] = {}\n        for e in self._entries:\n            for t in e.tags:\n                by_tag[t] = round_money(by_tag.get(t, 0.0) + e.amount)\n        avg = round_money(grand / count) if count else 0.0\n        return {\n            \"count\": count,\n            \"total\": grand,\n            \"average\": avg,\n            \"min\": min(amounts) if amounts else 0.0,\n            \"max\": max(amounts) if amounts else 0.0,\n            \"by_category\": by_category,\n            \"by_tag\": by_tag,\n        }\n\n    stats = summary\n\n    # ----- turn 4 / 13: persistence -------------------------------------\n    def save(self, path: str = None) -> str:\n        p = path or self._path\n        if not p:\n            raise ValidationError(\"no path to save to\")\n        storage.save(p, self._entries, self._next_id)\n        self._path = p\n        return p\n\n    @classmethod\n    def load(cls, path: str, config: Config = None) -> \"Tracker\":\n        state = storage.load(path)\n        return cls(entries=state[\"entries\"], next_id=state[\"next_id\"],\n                   config=config, path=path)\n\n    def to_dict(self) -> Dict[str, object]:\n        return {\n            \"version\": 2,\n            \"next_id\": self._next_id,\n            \"entries\": [e.to_dict() for e in self._entries],\n        }\n\n    @classmethod\n    def from_dict(cls, data, config: Config = None) -> \"Tracker\":\n        from .migrations import migrate\n        state = migrate(data)\n        entries = [Entry.from_dict(d) for d in state[\"entries\"]]\n        return cls(entries=entries, next_id=state[\"next_id\"], config=config)\n```\n\n# FILE: spend/core.py\n```python\n\"\"\"A thin fa\u00e7ade / CLI front-end tying the package together.\n\nMost callers use :class:`spend.Tracker` directly; ``core`` exists to provide a\nsingle conventional entry point (``main``) and to re-export the primary names so\n``from spend.core import Tracker, Config`` works.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom typing import List, Optional\n\nfrom .tracker import Tracker\nfrom .config import Config, load_config, default_data_path\nfrom .money import format_money\n\n\ndef build_tracker(data_path: str = None, config_path: str = None) -> Tracker:\n    config = load_config(config_path)\n    path = data_path or config.data_path or default_data_path()\n    try:\n        return Tracker.load(path, config=config)\n    except FileNotFoundError:\n        return Tracker(config=config, path=path)\n\n\ndef _build_parser() -> argparse.ArgumentParser:\n    parser = argparse.ArgumentParser(prog=\"spend\", description=\"expense tracker\")\n    parser.add_argument(\"--data\", dest=\"data\", default=None)\n    parser.add_argument(\"--config\", dest=\"config\", default=None)\n    sub = parser.add_subparsers(dest=\"command\")\n\n    p_add = sub.add_parser(\"add\", help=\"add an entry\")\n    p_add.add_argument(\"amount\")\n    p_add.add_argument(\"description\", nargs=\"?\", default=\"\")\n    p_add.add_argument(\"--date\", default=None)\n    p_add.add_argument(\"--category\", default=None)\n    p_add.add_argument(\"--tag\", action=\"append\", dest=\"tags\", default=None)\n\n    sub.add_parser(\"list\", help=\"list entries\")\n    sub.add_parser(\"summary\", help=\"show summary stats\")\n    return parser\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = _build_parser()\n    args = parser.parse_args(argv)\n    tracker = build_tracker(args.data, args.config)\n\n    if args.command == \"add\":\n        entry = tracker.add(\n            args.amount,\n            description=args.description,\n            date=args.date,\n            category=args.category,\n            tags=args.tags,\n        )\n        tracker.save()\n        print(f\"added #{entry.id}: {format_money(entry.amount)} {entry.description}\")\n        return 0\n\n    if args.command == \"list\":\n        for e in tracker.list():\n            print(f\"#{e.id} {e.date} {format_money(e.amount)} \"\n                  f\"[{e.category}] {e.description}\")\n        return 0\n\n    if args.command == \"summary\":\n        s = tracker.summary()\n        print(f\"count={s['count']} total={format_money(s['total'])} \"\n              f\"average={format_money(s['average'])}\")\n        return 0\n\n    parser.print_help()\n    return 0\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    raise SystemExit(main())\n```", "summary": "1 error"}