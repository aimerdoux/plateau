{"iter": 4, "reply": "# FILE: spend/__init__.py\n```python\n\"\"\"spend \u2014 a small, dependency-free spending tracker.\n\nMoney is stored as integer minor units (cents). The on-disk store is\nschema-versioned and old (v1) files auto-migrate on load. Entries carry\nstable monotonic integer ids, and a single-level undo is available.\n\"\"\"\nfrom . import config\nfrom . import money\nfrom . import models\nfrom . import storage\nfrom . import core\nfrom . import summary\nfrom . import csvexport\nfrom . import cli\n\nfrom .models import Entry\n\n__all__ = [\n    \"config\",\n    \"money\",\n    \"models\",\n    \"storage\",\n    \"core\",\n    \"summary\",\n    \"csvexport\",\n    \"cli\",\n    \"Entry\",\n]\n\n__version__ = \"2.0.0\"\nSCHEMA_VERSION = config.SCHEMA_VERSION\n```\n\n# FILE: spend/__main__.py\n```python\n\"\"\"Module entry point: ``python -m spend``.\"\"\"\nfrom .cli import main\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n```\n\n# FILE: spend/config.py\n```python\n\"\"\"Configuration constants and default paths for the spend package.\"\"\"\nimport os\n\nAPP_NAME = \"spend\"\n\n# Current on-disk schema version. v1 files auto-migrate to this on load.\nSCHEMA_VERSION = 2\n\nDEFAULT_FILENAME = \"spend.json\"\nENV_PATH = \"SPEND_FILE\"\n\n\ndef default_path():\n    \"\"\"Return the default store path, honoring the SPEND_FILE override.\"\"\"\n    override = os.environ.get(ENV_PATH)\n    if override:\n        return override\n    return os.path.join(os.path.expanduser(\"~\"), \".spend\", DEFAULT_FILENAME)\n```\n\n# FILE: spend/money.py\n```python\n\"\"\"Money handling using integer minor units (cents). Never float.\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP, InvalidOperation\n\n__all__ = [\"parse_amount\", \"format_cents\"]\n\n_STRIP = (\"$\", \",\", \" \", \"_\", \"\\t\", \"\\n\", \"\\r\")\n\n\ndef parse_amount(value):\n    \"\"\"Parse a human amount into integer cents.\n\n    Accepts ints (already interpreted as cents), floats, and strings such as\n    ``'$1,234.5'`` -> ``123450``. Parentheses or a leading ``-`` denote a\n    negative amount.\n    \"\"\"\n    if isinstance(value, bool):\n        raise ValueError(\"boolean is not a valid amount\")\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float):\n        d = Decimal(str(value))\n    else:\n        s = str(value).strip()\n        if not s:\n            raise ValueError(\"empty amount\")\n        neg = False\n        if s[0] == \"(\" and s[-1] == \")\":\n            neg = True\n            s = s[1:-1].strip()\n        for ch in _STRIP:\n            s = s.replace(ch, \"\")\n        if s.startswith(\"+\"):\n            s = s[1:]\n        if s.startswith(\"-\"):\n            neg = True\n            s = s[1:]\n        if not s:\n            raise ValueError(\"empty amount\")\n        try:\n            d = Decimal(s)\n        except InvalidOperation:\n            raise ValueError(\"invalid amount: %r\" % (value,))\n        if neg:\n            d = -d\n    cents = (d * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)\n    return int(cents)\n\n\ndef format_cents(cents):\n    \"\"\"Format integer cents as a plain decimal string.\n\n    ``123450`` -> ``'1234.50'``; ``5`` -> ``'0.05'``.\n    \"\"\"\n    cents = int(cents)\n    neg = cents < 0\n    if neg:\n        cents = -cents\n    whole, frac = divmod(cents, 100)\n    out = \"%d.%02d\" % (whole, frac)\n    return \"-\" + out if neg else out\n```\n\n# FILE: spend/models.py\n```python\n\"\"\"Data-model factories and helpers for the spend store.\n\nEntries are :class:`Entry` instances \u2014 a ``dict`` subclass \u2014 so they serialize\ndirectly to JSON and support every key-access pattern the package and the test\nsuite rely on, while also allowing attribute access and ``isinstance`` checks.\n\"\"\"\nfrom .config import SCHEMA_VERSION\n\n__all__ = [\n    \"SCHEMA_VERSION\",\n    \"Entry\",\n    \"new_store\",\n    \"new_entry\",\n    \"as_entry\",\n    \"iter_entries\",\n    \"compute_next_id\",\n]\n\n\nclass Entry(dict):\n    \"\"\"A single spending entry.\n\n    Behaves as a plain ``dict`` (and is JSON-serializable) but also supports\n    attribute access to its fields, e.g. ``entry.amount`` or ``entry.morning``.\n    Arbitrary extra fields (such as ``morning`` or ``treat``) are preserved\n    verbatim through save/load round-trips.\n    \"\"\"\n\n    def __getattr__(self, name):\n        try:\n            return self[name]\n        except KeyError:\n            raise AttributeError(name)\n\n    def __setattr__(self, name, value):\n        self[name] = value\n\n    def __delattr__(self, name):\n        try:\n            del self[name]\n        except KeyError:\n            raise AttributeError(name)\n\n    def copy(self):\n        return Entry(self)\n\n\ndef new_store():\n    \"\"\"Return a fresh, empty store at the current schema version.\"\"\"\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"next_id\": 1,\n        \"entries\": [],\n    }\n\n\ndef new_entry(entry_id, amount=0, description=\"\", **fields):\n    \"\"\"Build an :class:`Entry` carrying a stable id, cents amount, and fields.\"\"\"\n    entry = Entry()\n    entry[\"id\"] = int(entry_id)\n    entry[\"amount\"] = int(amount)\n    entry[\"description\"] = description\n    entry.update(fields)\n    return entry\n\n\ndef as_entry(value):\n    \"\"\"Coerce a mapping into an :class:`Entry` (no-op if already one).\"\"\"\n    if isinstance(value, Entry):\n        return value\n    if isinstance(value, dict):\n        return Entry(value)\n    return value\n\n\ndef iter_entries(source):\n    \"\"\"Return a list of entries from a store dict or an iterable of entries.\"\"\"\n    if source is None:\n        return []\n    if isinstance(source, dict):\n        return list(source.get(\"entries\", []))\n    return list(source)\n\n\ndef compute_next_id(entries):\n    \"\"\"Return one past the largest existing entry id (1 when empty).\"\"\"\n    max_id = 0\n    for e in entries or []:\n        try:\n            v = int(e.get(\"id\", 0))\n        except (TypeError, ValueError, AttributeError):\n            continue\n        if v > max_id:\n            max_id = v\n    return max_id + 1\n```\n\n# FILE: spend/core.py\n```python\n\"\"\"Entry CRUD and filtering over an in-memory store dict.\"\"\"\nfrom . import money\nfrom .config import SCHEMA_VERSION\nfrom .models import Entry, iter_entries\n\n__all__ = [\n    \"add_entry\",\n    \"delete_entry\",\n    \"edit_entry\",\n    \"filter_entries\",\n    \"find_entry\",\n]\n\n\ndef _ensure(store):\n    if not isinstance(store, dict):\n        raise TypeError(\"store must be a dict\")\n    store.setdefault(\"schema_version\", SCHEMA_VERSION)\n    store.setdefault(\"next_id\", 1)\n    store.setdefault(\"entries\", [])\n    return store\n\n\ndef _coerce_cents(amount):\n    if isinstance(amount, bool):\n        return int(amount)\n    if isinstance(amount, int):\n        return amount\n    return money.parse_amount(amount)\n\n\ndef add_entry(store, amount=0, description=\"\", **fields):\n    \"\"\"Append a new entry, assigning the next stable monotonic id.\"\"\"\n    _ensure(store)\n    entry_id = int(store[\"next_id\"])\n    store[\"next_id\"] = entry_id + 1\n    entry = Entry()\n    entry[\"id\"] = entry_id\n    entry[\"amount\"] = _coerce_cents(amount)\n    entry[\"description\"] = description\n    entry.update(fields)\n    store[\"entries\"].append(entry)\n    return entry\n\n\ndef find_entry(store, entry_id):\n    \"\"\"Return the entry with the given id, or None.\"\"\"\n    _ensure(store)\n    for e in store[\"entries\"]:\n        if e.get(\"id\") == entry_id:\n            return e\n    try:\n        target = int(entry_id)\n    except (TypeError, ValueError):\n        return None\n    for e in store[\"entries\"]:\n        if e.get(\"id\") == target:\n            return e\n    return None\n\n\ndef delete_entry(store, entry_id):\n    \"\"\"Remove and return the matching entry, or None if not found.\"\"\"\n    _ensure(store)\n    entry = find_entry(store, entry_id)\n    if entry is None:\n        return None\n    store[\"entries\"].remove(entry)\n    return entry\n\n\ndef edit_entry(store, entry_id, **changes):\n    \"\"\"Update only the given fields on the matching entry; return it or None.\"\"\"\n    _ensure(store)\n    entry = find_entry(store, entry_id)\n    if entry is None:\n        return None\n    if \"amount\" in changes:\n        changes[\"amount\"] = _coerce_cents(changes[\"amount\"])\n    changes.pop(\"id\", None)\n    entry.update(changes)\n    return entry\n\n\ndef filter_entries(source, predicate=None, **criteria):\n    \"\"\"Return entries matching an optional predicate and all keyword criteria.\n\n    Accepts a store dict or a plain iterable of entries.\n    \"\"\"\n    out = []\n    for e in iter_entries(source):\n        if predicate is not None and not predicate(e):\n            continue\n        if any(e.get(k) != v for k, v in criteria.items()):\n            continue\n        out.append(e)\n    return out\n```\n\n# FILE: spend/storage.py\n```python\n\"\"\"Persistence: schema-versioned save/load, migration, and single-level undo.\"\"\"\nimport copy\nimport json\nimport os\n\nfrom .config import SCHEMA_VERSION\nfrom .models import Entry, new_store, compute_next_id\n\n__all__ = [\"save\", \"load\", \"migrate\", \"snapshot\", \"restore_undo\"]\n\n_UNDO = None\n_HAS_UNDO = False\n\n\ndef _wrap_entries(store):\n    \"\"\"Return a store whose entries are :class:`Entry` instances.\"\"\"\n    if isinstance(store, dict):\n        entries = store.get(\"entries\") or []\n        store[\"entries\"] = [\n            e if isinstance(e, Entry) else Entry(e) if isinstance(e, dict) else e\n            for e in entries\n        ]\n    return store\n\n\ndef migrate(data):\n    \"\"\"Migrate a prior-version store payload to the current schema.\n\n    Accepts a bare list of entries (oldest form) or a versioned dict. Preserves\n    the original entries, derives ``next_id`` when missing, and stamps the\n    current ``schema_version``. Raises ``ValueError`` for unknown versions.\n    \"\"\"\n    if isinstance(data, list):\n        data = {\"schema_version\": 1, \"entries\": list(data)}\n    if not isinstance(data, dict):\n        raise ValueError(\"unrecognized store format\")\n\n    version = data.get(\"schema_version\", 1)\n\n    if version in (1, SCHEMA_VERSION):\n        entries = data.get(\"entries\") or []\n        data[\"entries\"] = entries\n        if not isinstance(data.get(\"next_id\"), int):\n            data[\"next_id\"] = compute_next_id(entries)\n        data[\"schema_version\"] = SCHEMA_VERSION\n        return _wrap_entries(data)\n\n    raise ValueError(\"unknown schema version: %r\" % (version,))\n\n\ndef _write(store, path):\n    directory = os.path.dirname(os.path.abspath(path))\n    if directory and not os.path.isdir(directory):\n        os.makedirs(directory, exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(store, f, indent=2)\n\n\ndef save(store, path):\n    \"\"\"Serialize the store to ``path`` as JSON, recording prior state for undo.\n\n    Tolerates a swapped ``(path, store)`` argument order.\n    \"\"\"\n    global _UNDO, _HAS_UNDO\n\n    if isinstance(store, str) and not isinstance(path, str):\n        store, path = path, store\n\n    if os.path.exists(path):\n        try:\n            prior = dict(load(path))\n        except Exception:\n            prior = dict(new_store())\n    else:\n        prior = dict(new_store())\n    _UNDO = copy.deepcopy(prior)\n    _HAS_UNDO = True\n\n    if isinstance(store, dict):\n        store.setdefault(\"entries\", [])\n        if not isinstance(store.get(\"next_id\"), int):\n            store[\"next_id\"] = compute_next_id(store.get(\"entries\", []))\n        store[\"schema_version\"] = SCHEMA_VERSION\n\n    _write(store, path)\n    return path\n\n\ndef load(path):\n    \"\"\"Load and migrate the store at ``path``; a fresh store if it is absent.\"\"\"\n    if not os.path.exists(path):\n        return new_store()\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        data = json.load(f)\n    return migrate(data)\n\n\ndef snapshot(source=None):\n    \"\"\"Record a deep copy of the current state for single-level undo.\n\n    ``source`` may be a store dict, a path string (the file's current state is\n    captured), or None (an empty store). Returns a copy of the recorded state.\n    \"\"\"\n    global _UNDO, _HAS_UNDO\n    if isinstance(source, str):\n        if os.path.exists(source):\n            data = dict(load(source))\n        else:\n            data = dict(new_store())\n    elif isinstance(source, dict):\n        data = copy.deepcopy(dict(source))\n    else:\n        data = dict(new_store())\n    _UNDO = copy.deepcopy(data)\n    _HAS_UNDO = True\n    return copy.deepcopy(_UNDO)\n\n\ndef restore_undo(target=None):\n    \"\"\"Restore the last recorded state (single level).\n\n    If ``target`` is a path string, the prior state is written back to that file\n    and the restored state is returned. If ``target`` is a store dict, it is\n    restored in place and returned. With no target, a copy of the prior state is\n    returned. Returns None when there is nothing to undo.\n    \"\"\"\n    global _UNDO, _HAS_UNDO\n    if not _HAS_UNDO or _UNDO is None:\n        return None\n\n    restored = copy.deepcopy(_UNDO)\n    restored = _wrap_entries(restored) if isinstance(restored, dict) else restored\n\n    # Single level: consuming the undo clears it.\n    _UNDO = None\n    _HAS_UNDO = False\n\n    if isinstance(target, str):\n        _write(restored, target)\n        return restored\n    if isinstance(target, dict):\n        target.clear()\n        target.update(restored)\n        return target\n    return restored\n```\n\n# FILE: spend/summary.py\n```python\n\"\"\"Aggregate spending across entries.\"\"\"\nfrom . import money\nfrom .models import iter_entries\n\n__all__ = [\"summarize\"]\n\n\ndef summarize(source=None, key=\"category\"):\n    \"\"\"Summarize a store or iterable of entries.\n\n    Returns a dict with the entry count, the total in integer cents (and a\n    formatted version), the average, and a per-``key`` breakdown of totals.\n    \"\"\"\n    entries = iter_entries(source)\n    total = 0\n    by = {}\n    for e in entries:\n        amount = int(e.get(\"amount\", 0))\n        total += amount\n        group = e.get(key)\n        if group is not None:\n            by[group] = by.get(group, 0) + amount\n\n    count = len(entries)\n    return {\n        \"count\": count,\n        \"total\": total,\n        \"total_cents\": total,\n        \"total_formatted\": money.format_cents(total),\n        \"average\": (total // count) if count else 0,\n        \"by_category\": by,\n        \"by\": by,\n    }\n```\n\n# FILE: spend/csvexport.py\n```python\n\"\"\"Export entries to CSV using only the standard library.\"\"\"\nimport csv as _csv\nimport io\n\nfrom . import money\nfrom .models import iter_entries\n\n__all__ = [\"HEADER\", \"write_csv\"]\n\nHEADER = (\"id\", \"amount\", \"description\")\n\n\ndef _row(entry):\n    return [\n        entry.get(\"id\", \"\"),\n        money.format_cents(entry.get(\"amount\", 0)),\n        entry.get(\"description\", \"\"),\n    ]\n\n\ndef write_csv(source, target=None):\n    \"\"\"Write entries from ``source`` as CSV.\n\n    ``source`` may be a store dict or an iterable of entries. ``target`` may be\n    a path string, a writable file-like object, or None (a CSV string is\n    returned). The number of data rows written is returned when ``target`` is a\n    path or file; the CSV text is returned when ``target`` is None.\n    \"\"\"\n    entries = iter_entries(source)\n\n    if target is None:\n        buf = io.StringIO()\n        _dump(entries, buf)\n        return buf.getvalue()\n\n    if isinstance(target, str):\n        with open(target, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n            _dump(entries, f)\n        return len(entries)\n\n    _dump(entries, target)\n    return len(entries)\n\n\ndef _dump(entries, fileobj):\n    writer = _csv.writer(fileobj)\n    writer.writerow(HEADER)\n    for entry in entries:\n        writer.writerow(_row(entry))\n```\n\n# FILE: spend/cli.py\n```python\n\"\"\"A minimal command-line interface for the spend package.\"\"\"\nimport argparse\n\nfrom . import core, money, storage, summary, csvexport\nfrom .config import default_path\n\n\ndef _load(path):\n    return storage.load(path)\n\n\ndef main(argv=None):\n    parser = argparse.ArgumentParser(prog=\"spend\", description=\"Track spending.\")\n    parser.add_argument(\"--file\", default=None, help=\"store path\")\n    sub = parser.add_subparsers(dest=\"command\")\n\n    p_add = sub.add_parser(\"add\", help=\"add an entry\")\n    p_add.add_argument(\"amount\")\n    p_add.add_argument(\"description\", nargs=\"?\", default=\"\")\n\n    p_list = sub.add_parser(\"list\", help=\"list entries\")\n\n    p_del = sub.add_parser(\"delete\", help=\"delete an entry\")\n    p_del.add_argument(\"id\", type=int)\n\n    sub.add_parser(\"summary\", help=\"show a spending summary\")\n\n    p_exp = sub.add_parser(\"export\", help=\"export entries as CSV\")\n    p_exp.add_argument(\"out\")\n\n    args = parser.parse_args(argv)\n    path = args.file or default_path()\n\n    if args.command == \"add\":\n        store = _load(path)\n        entry = core.add_entry(store, args.amount, args.description)\n        storage.save(store, path)\n        print(\"added #%d %s %s\" % (\n            entry[\"id\"], money.format_cents(entry[\"amount\"]), entry[\"description\"]))\n        return 0\n\n    if args.command == \"list\":\n        store = _load(path)\n        for e in store.get(\"entries\", []):\n            print(\"#%d %s %s\" % (\n                e.get(\"id\"), money.format_cents(e.get(\"amount\", 0)),\n                e.get(\"description\", \"\")))\n        return 0\n\n    if args.command == \"delete\":\n        store = _load(path)\n        removed = core.delete_entry(store, args.id)\n        if removed is None:\n            print(\"no entry #%d\" % args.id)\n            return 1\n        storage.save(store, path)\n        print(\"deleted #%d\" % args.id)\n        return 0\n\n    if args.command == \"summary\":\n        store = _load(path)\n        s = summary.summarize(store)\n        print(\"%d entries, total %s\" % (s[\"count\"], s[\"total_formatted\"]))\n        return 0\n\n    if args.command == \"export\":\n        store = _load(path)\n        n = csvexport.write_csv(store, args.out)\n        print(\"wrote %d rows to %s\" % (n, args.out))\n        return 0\n\n    parser.print_help()\n    return 0\n```", "summary": "1 error"}