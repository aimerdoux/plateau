{"iter": 0, "reply": "# FILE: spend/__init__.py\n```python\n\"\"\"spend \u2014 a small, dependency-free spending tracker.\n\nMoney is stored as integer minor units (cents). The on-disk store is\nschema-versioned and old files auto-migrate on load. Entries carry stable\nmonotonic integer ids, and a single-level undo is available.\n\"\"\"\nfrom . import config, money, models, storage, core, summary, csvexport\nfrom . import cli\n\n__all__ = [\n    \"config\",\n    \"money\",\n    \"models\",\n    \"storage\",\n    \"core\",\n    \"summary\",\n    \"csvexport\",\n    \"cli\",\n]\n\n__version__ = \"2.0.0\"\nSCHEMA_VERSION = config.SCHEMA_VERSION\n```\n\n# FILE: spend/__main__.py\n```python\n\"\"\"Module entry point: ``python -m spend``.\"\"\"\nfrom .cli import main\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n```\n\n# FILE: spend/config.py\n```python\n\"\"\"Configuration constants and default paths for the spend package.\"\"\"\nimport os\n\nAPP_NAME = \"spend\"\n\n# Current on-disk schema version. v1 files auto-migrate to this on load.\nSCHEMA_VERSION = 2\n\nDEFAULT_FILENAME = \"spend.json\"\nENV_PATH = \"SPEND_FILE\"\n\n\ndef default_path():\n    \"\"\"Return the default store path, honoring the SPEND_FILE override.\"\"\"\n    override = os.environ.get(ENV_PATH)\n    if override:\n        return override\n    return os.path.join(os.path.expanduser(\"~\"), \".spend\", DEFAULT_FILENAME)\n```\n\n# FILE: spend/money.py\n```python\n\"\"\"Money handling using integer minor units (cents). Never float.\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP, InvalidOperation\n\n__all__ = [\"parse_amount\", \"format_cents\"]\n\n_STRIP = (\"$\", \",\", \" \", \"_\", \"\\t\", \"\\n\", \"\\r\")\n\n\ndef parse_amount(value):\n    \"\"\"Parse a human amount into integer cents.\n\n    Accepts ints (already interpreted as cents), floats, and strings such as\n    ``'$1,234.5'`` -> ``123450``. Parentheses or a leading ``-`` denote a\n    negative amount.\n    \"\"\"\n    if isinstance(value, bool):\n        raise ValueError(\"boolean is not a valid amount\")\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float):\n        d = Decimal(str(value))\n    else:\n        s = str(value).strip()\n        if not s:\n            raise ValueError(\"empty amount\")\n        neg = False\n        if s[0] == \"(\" and s[-1] == \")\":\n            neg = True\n            s = s[1:-1].strip()\n        for ch in _STRIP:\n            s = s.replace(ch, \"\")\n        if s.startswith(\"+\"):\n            s = s[1:]\n        if s.startswith(\"-\"):\n            neg = True\n            s = s[1:]\n        if not s:\n            raise ValueError(\"empty amount\")\n        try:\n            d = Decimal(s)\n        except InvalidOperation:\n            raise ValueError(\"invalid amount: %r\" % (value,))\n        if neg:\n            d = -d\n    cents = (d * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)\n    return int(cents)\n\n\ndef format_cents(cents):\n    \"\"\"Format integer cents as a plain decimal string.\n\n    ``123450`` -> ``'1234.50'``; ``5`` -> ``'0.05'``.\n    \"\"\"\n    cents = int(cents)\n    neg = cents < 0\n    if neg:\n        cents = -cents\n    whole, frac = divmod(cents, 100)\n    out = \"%d.%02d\" % (whole, frac)\n    return \"-\" + out if neg else out\n```\n\n# FILE: spend/models.py\n```python\n\"\"\"Data-model factories for the spend store and its entries.\"\"\"\nfrom .config import SCHEMA_VERSION\n\n__all__ = [\"SCHEMA_VERSION\", \"new_store\", \"new_entry\"]\n\n\ndef new_store():\n    \"\"\"Return a fresh, empty store at the current schema version.\"\"\"\n    return {\"schema_version\": SCHEMA_VERSION, \"next_id\": 1, \"entries\": []}\n\n\ndef new_entry(entry_id, amount=0, description=\"\", **fields):\n    \"\"\"Build an entry dict carrying a stable id, cents amount, and extra fields.\"\"\"\n    entry = {\"id\": int(entry_id), \"amount\": int(amount), \"description\": description}\n    entry.update(fields)\n    return entry\n```\n\n# FILE: spend/core.py\n```python\n\"\"\"Entry CRUD and filtering over an in-memory store dict.\"\"\"\nfrom . import money\nfrom .config import SCHEMA_VERSION\n\n__all__ = [\n    \"add_entry\",\n    \"delete_entry\",\n    \"edit_entry\",\n    \"filter_entries\",\n    \"find_entry\",\n]\n\n\ndef _ensure(store):\n    if not isinstance(store, dict):\n        raise TypeError(\"store must be a dict\")\n    store.setdefault(\"schema_version\", SCHEMA_VERSION)\n    store.setdefault(\"next_id\", 1)\n    store.setdefault(\"entries\", [])\n    return store\n\n\ndef _coerce_cents(amount):\n    if isinstance(amount, bool):\n        return int(amount)\n    if isinstance(amount, int):\n        return amount\n    return money.parse_amount(amount)\n\n\ndef add_entry(store, amount=0, description=\"\", **fields):\n    \"\"\"Append a new entry, assigning the next stable monotonic id.\"\"\"\n    _ensure(store)\n    entry_id = int(store[\"next_id\"])\n    store[\"next_id\"] = entry_id + 1\n    entry = {\n        \"id\": entry_id,\n        \"amount\": _coerce_cents(amount),\n        \"description\": description,\n    }\n    entry.update(fields)\n    store[\"entries\"].append(entry)\n    return entry\n\n\ndef find_entry(store, entry_id):\n    \"\"\"Return the entry with the given id, or None.\"\"\"\n    _ensure(store)\n    for e in store[\"entries\"]:\n        if e.get(\"id\") == entry_id:\n            return e\n    try:\n        target = int(entry_id)\n    except (TypeError, ValueError):\n        return None\n    for e in store[\"entries\"]:\n        if e.get(\"id\") == target:\n            return e\n    return None\n\n\ndef delete_entry(store, entry_id):\n    \"\"\"Remove and return the matching entry, or None if not found.\"\"\"\n    _ensure(store)\n    entry = find_entry(store, entry_id)\n    if entry is None:\n        return None\n    store[\"entries\"].remove(entry)\n    return entry\n\n\ndef edit_entry(store, entry_id, **changes):\n    \"\"\"Update fields on the matching entry; return it, or None if not found.\"\"\"\n    _ensure(store)\n    entry = find_entry(store, entry_id)\n    if entry is None:\n        return None\n    if \"amount\" in changes:\n        changes[\"amount\"] = _coerce_cents(changes[\"amount\"])\n    changes.pop(\"id\", None)\n    entry.update(changes)\n    return entry\n\n\ndef filter_entries(store, predicate=None, **criteria):\n    \"\"\"Return entries matching an optional predicate and all keyword criteria.\"\"\"\n    _ensure(store)\n    out = []\n    for e in store[\"entries\"]:\n        if predicate is not None and not predicate(e):\n            continue\n        if any(e.get(k) != v for k, v in criteria.items()):\n            continue\n        out.append(e)\n    return out\n```\n\n# FILE: spend/storage.py\n```python\n\"\"\"Persistence: schema-versioned save/load, migration, and single-level undo.\"\"\"\nimport copy\nimport json\nimport os\n\nfrom .config import SCHEMA_VERSION\nfrom .models import new_store\n\n__all__ = [\"save\", \"load\", \"migrate\", \"snapshot\", \"restore_undo\"]\n\n_UNDO = None\n\n\ndef _compute_next_id(entries):\n    max_id = 0\n    for e in entries or []:\n        try:\n            v = int(e.get(\"id\", 0))\n        except (TypeError, ValueError, AttributeError):\n            continue\n        if v > max_id:\n            max_id = v\n    return max_id + 1\n\n\ndef migrate(data):\n    \"\"\"Migrate any prior-version store payload to the current schema in place.\n\n    Accepts a bare list of entries (oldest form) or a dict. Preserves the\n    original entries, derives ``next_id`` when missing, and stamps the current\n    ``schema_version``. Idempotent for already-current stores.\n    \"\"\"\n    if isinstance(data, list):\n        data = {\"schema_version\": 1, \"entries\": list(data)}\n    if not isinstance(data, dict):\n        raise ValueError(\"unrecognized store format\")\n    entries = data.get(\"entries\")\n    if entries is None:\n        entries = []\n    data[\"entries\"] = entries\n    if \"next_id\" not in data or not isinstance(data.get(\"next_id\"), int):\n        data[\"next_id\"] = _compute_next_id(entries)\n    data[\"schema_version\"] = SCHEMA_VERSION\n    return data\n\n\ndef save(store, path):\n    \"\"\"Serialize the store to ``path`` as JSON, ensuring it is versioned.\"\"\"\n    if isinstance(store, dict):\n        store.setdefault(\"entries\", [])\n        store.setdefault(\"next_id\", _compute_next_id(store.get(\"entries\", [])))\n        store[\"schema_version\"] = SCHEMA_VERSION\n    directory = os.path.dirname(os.path.abspath(path))\n    if directory and not os.path.isdir(directory):\n        os.makedirs(directory, exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(store, f, indent=2)\n    return path\n\n\ndef load(path):\n    \"\"\"Load and migrate the store at ``path``; a fresh store if it is absent.\"\"\"\n    if not os.path.exists(path):\n        return new_store()\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        data = json.load(f)\n    return migrate(data)\n\n\ndef snapshot(store):\n    \"\"\"Record a deep copy of ``store`` for single-level undo; return the copy.\"\"\"\n    global _UNDO\n    _UNDO = copy.deepcopy(store)\n    return _UNDO\n\n\ndef restore_undo(store=None):\n    \"\"\"Restore the last snapshot.\n\n    If ``store`` is a dict it is restored in place and returned; otherwise a\n    deep copy of the snapshot is returned. Returns ``store`` unchanged when no\n    snapshot exists.\n    \"\"\"\n    global _UNDO\n    if _UNDO is None:\n        return store\n    restored = copy.deepcopy(_UNDO)\n    if isinstance(store, dict):\n        store.clear()\n        store.update(restored)\n        return store\n    return restored\n```\n\n# FILE: spend/csvexport.py\n```python\n\"\"\"Export entries to CSV.\"\"\"\nimport csv\n\nfrom . import money\n\n__all__ = [\"HEADER\", \"write_csv\"]\n\nHEADER = (\"id\", \"date\", \"description\", \"amount\")\n\n\ndef _entries(data):\n    if isinstance(data, dict) and \"entries\" in data:\n        return data[\"entries\"]\n    return data\n\n\ndef write_csv(data, path):\n    \"\"\"Write entries (a store dict or a list) to ``path`` as CSV; return path.\"\"\"\n    entries = _entries(data)\n    with open(path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n        writer = csv.writer(f)\n        writer.writerow(HEADER)\n        for e in entries:\n            writer.writerow([\n                e.get(\"id\", \"\"),\n                e.get(\"date\", \"\"),\n                e.get(\"description\", \"\"),\n                money.format_cents(e.get(\"amount\", 0)),\n            ])\n    return path\n```\n\n# FILE: spend/summary.py\n```python\n\"\"\"Aggregate summaries over entries.\"\"\"\nfrom . import money\n\n__all__ = [\"summarize\"]\n\n\ndef _entries(data):\n    if isinstance(data, dict) and \"entries\" in data:\n        return data[\"entries\"]\n    return data\n\n\ndef summarize(data):\n    \"\"\"Return totals over entries (a store dict or a list).\n\n    Keys: ``count``, ``total`` (cents), ``total_cents``, ``total_formatted``,\n    and ``by_description`` (cents per description).\n    \"\"\"\n    entries = list(_entries(data))\n    total = sum(int(e.get(\"amount\", 0)) for e in entries)\n    by_description = {}\n    for e in entries:\n        key = e.get(\"description\", \"\")\n        by_description[key] = by_description.get(key, 0) + int(e.get(\"amount\", 0))\n    return {\n        \"count\": len(entries),\n        \"total\": total,\n        \"total_cents\": total,\n        \"total_formatted\": money.format_cents(total),\n        \"by_description\": by_description,\n    }\n```\n\n# FILE: spend/cli.py\n```python\n\"\"\"Command-line interface for the spend tracker.\"\"\"\nimport argparse\n\nfrom . import config, core, storage, summary, csvexport, money\n\n\ndef _add(args):\n    store = storage.load(args.path)\n    storage.snapshot(store)\n    fields = {}\n    if args.morning:\n        fields[\"morning\"] = True\n    if args.treat:\n        fields[\"treat\"] = True\n    if args.date:\n        fields[\"date\"] = args.date\n    entry = core.add_entry(\n        store, args.amount, description=args.description or \"\", **fields\n    )\n    storage.save(store, args.path)\n    print(\"added #%d %s %s\" % (\n        entry[\"id\"], money.format_cents(entry[\"amount\"]), entry.get(\"description\", \"\")\n    ))\n    return 0\n\n\ndef _list(args):\n    store = storage.load(args.path)\n    for e in store[\"entries\"]:\n        print(\"#%d %s %s\" % (\n            e[\"id\"], money.format_cents(e.get(\"amount\", 0)), e.get(\"description\", \"\")\n        ))\n    return 0\n\n\ndef _delete(args):\n    store = storage.load(args.path)\n    storage.snapshot(store)\n    entry = core.delete_entry(store, args.id)\n    storage.save(store, args.path)\n    print(\"deleted\" if entry else \"not found\")\n    return 0 if entry else 1\n\n\ndef _edit(args):\n    store = storage.load(args.path)\n    storage.snapshot(store)\n    changes = {}\n    if args.amount is not None:\n        changes[\"amount\"] = args.amount\n    if args.description is not None:\n        changes[\"description\"] = args.description\n    entry = core.edit_entry(store, args.id, **changes)\n    storage.save(store, args.path)\n    print(\"edited\" if entry else \"not found\")\n    return 0 if entry else 1\n\n\ndef _summary(args):\n    store = storage.load(args.path)\n    s = summary.summarize(store)\n    print(\"count=%d total=%s\" % (s[\"count\"], s[\"total_formatted\"]))\n    return 0\n\n\ndef _export(args):\n    store = storage.load(args.path)\n    csvexport.write_csv(store, args.out)\n    print(\"wrote %s\" % args.out)\n    return 0\n\n\ndef _undo(args):\n    store = storage.load(args.path)\n    restored = storage.restore_undo(store)\n    if restored is None:\n        print(\"nothing to undo\")\n        return 1\n    storage.save(restored, args.path)\n    print(\"undone\")\n    return 0\n\n\ndef build_parser():\n    p = argparse.ArgumentParser(prog=config.APP_NAME, description=\"Track spending.\")\n    p.add_argument(\"--path\", default=config.default_path())\n    sub = p.add_subparsers(dest=\"command\")\n\n    a = sub.add_parser(\"add\", help=\"add an entry\")\n    a.add_argument(\"amount\")\n    a.add_argument(\"description\", nargs=\"?\", default=\"\")\n    a.add_argument(\"--morning\", action=\"store_true\")\n    a.add_argument(\"--treat\", action=\"store_true\")\n    a.add_argument(\"--date\", default=None)\n    a.set_defaults(func=_add)\n\n    l = sub.add_parser(\"list\", help=\"list entries\")\n    l.set_defaults(func=_list)\n\n    d = sub.add_parser(\"delete\", help=\"delete an entry\")\n    d.add_argument(\"id\", type=int)\n    d.set_defaults(func=_delete)\n\n    e = sub.add_parser(\"edit\", help=\"edit an entry\")\n    e.add_argument(\"id\", type=int)\n    e.add_argument(\"--amount\", default=None)\n    e.add_argument(\"--description\", default=None)\n    e.set_defaults(func=_edit)\n\n    s = sub.add_parser(\"summary\", help=\"show totals\")\n    s.set_defaults(func=_summary)\n\n    x = sub.add_parser(\"export\", help=\"export to CSV\")\n    x.add_argument(\"out\")\n    x.set_defaults(func=_export)\n\n    u = sub.add_parser(\"undo\", help=\"undo the last mutation\")\n    u.set_defaults(func=_undo)\n\n    return p\n\n\ndef main(argv=None):\n    parser = build_parser()\n    args = parser.parse_args(argv)\n    if not getattr(args, \"func\", None):\n        parser.print_help()\n        return 0\n    return args.func(args)\n```", "summary": "1 error"}