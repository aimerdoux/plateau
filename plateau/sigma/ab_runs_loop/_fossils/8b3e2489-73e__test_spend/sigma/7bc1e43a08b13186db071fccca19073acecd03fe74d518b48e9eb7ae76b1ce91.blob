{"iter": 3, "reply": "# FILE: spend/__init__.py\n```python\n\"\"\"spend \u2014 a small, dependency-free spending tracker.\n\nMoney is stored as integer minor units (cents). The on-disk store is\nschema-versioned and old (v1) files auto-migrate on load. Entries carry\nstable monotonic integer ids, and a single-level undo is available.\n\"\"\"\nfrom . import config\nfrom . import money\nfrom . import models\nfrom . import storage\nfrom . import core\nfrom . import summary\nfrom . import csvexport\nfrom . import cli\n\n__all__ = [\n    \"config\",\n    \"money\",\n    \"models\",\n    \"storage\",\n    \"core\",\n    \"summary\",\n    \"csvexport\",\n    \"cli\",\n]\n\n__version__ = \"2.0.0\"\nSCHEMA_VERSION = config.SCHEMA_VERSION\n```\n\n# FILE: spend/__main__.py\n```python\n\"\"\"Module entry point: ``python -m spend``.\"\"\"\nfrom .cli import main\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n```\n\n# FILE: spend/config.py\n```python\n\"\"\"Configuration constants and default paths for the spend package.\"\"\"\nimport os\n\nAPP_NAME = \"spend\"\n\n# Current on-disk schema version. v1 files auto-migrate to this on load.\nSCHEMA_VERSION = 2\n\nDEFAULT_FILENAME = \"spend.json\"\nENV_PATH = \"SPEND_FILE\"\n\n\ndef default_path():\n    \"\"\"Return the default store path, honoring the SPEND_FILE override.\"\"\"\n    override = os.environ.get(ENV_PATH)\n    if override:\n        return override\n    return os.path.join(os.path.expanduser(\"~\"), \".spend\", DEFAULT_FILENAME)\n```\n\n# FILE: spend/money.py\n```python\n\"\"\"Money handling using integer minor units (cents). Never float.\"\"\"\nfrom decimal import Decimal, ROUND_HALF_UP, InvalidOperation\n\n__all__ = [\"parse_amount\", \"format_cents\"]\n\n_STRIP = (\"$\", \",\", \" \", \"_\", \"\\t\", \"\\n\", \"\\r\")\n\n\ndef parse_amount(value):\n    \"\"\"Parse a human amount into integer cents.\n\n    Accepts ints (already interpreted as cents), floats, and strings such as\n    ``'$1,234.5'`` -> ``123450``. Parentheses or a leading ``-`` denote a\n    negative amount.\n    \"\"\"\n    if isinstance(value, bool):\n        raise ValueError(\"boolean is not a valid amount\")\n    if isinstance(value, int):\n        return value\n    if isinstance(value, float):\n        d = Decimal(str(value))\n    else:\n        s = str(value).strip()\n        if not s:\n            raise ValueError(\"empty amount\")\n        neg = False\n        if s[0] == \"(\" and s[-1] == \")\":\n            neg = True\n            s = s[1:-1].strip()\n        for ch in _STRIP:\n            s = s.replace(ch, \"\")\n        if s.startswith(\"+\"):\n            s = s[1:]\n        if s.startswith(\"-\"):\n            neg = True\n            s = s[1:]\n        if not s:\n            raise ValueError(\"empty amount\")\n        try:\n            d = Decimal(s)\n        except InvalidOperation:\n            raise ValueError(\"invalid amount: %r\" % (value,))\n        if neg:\n            d = -d\n    cents = (d * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)\n    return int(cents)\n\n\ndef format_cents(cents):\n    \"\"\"Format integer cents as a plain decimal string.\n\n    ``123450`` -> ``'1234.50'``; ``5`` -> ``'0.05'``.\n    \"\"\"\n    cents = int(cents)\n    neg = cents < 0\n    if neg:\n        cents = -cents\n    whole, frac = divmod(cents, 100)\n    out = \"%d.%02d\" % (whole, frac)\n    return \"-\" + out if neg else out\n```\n\n# FILE: spend/models.py\n```python\n\"\"\"Data-model factories and helpers for the spend store.\n\nEntries and the store are plain ``dict`` objects so they serialize directly to\nJSON and support all the key access the package and the test suite rely on.\n\"\"\"\nfrom .config import SCHEMA_VERSION\n\n__all__ = [\n    \"SCHEMA_VERSION\",\n    \"new_store\",\n    \"new_entry\",\n    \"iter_entries\",\n    \"compute_next_id\",\n]\n\n\ndef new_store():\n    \"\"\"Return a fresh, empty store at the current schema version.\"\"\"\n    return {\n        \"schema_version\": SCHEMA_VERSION,\n        \"next_id\": 1,\n        \"entries\": [],\n    }\n\n\ndef new_entry(entry_id, amount=0, description=\"\", **fields):\n    \"\"\"Build an entry dict carrying a stable id, cents amount, and fields.\"\"\"\n    entry = {\n        \"id\": int(entry_id),\n        \"amount\": int(amount),\n        \"description\": description,\n    }\n    entry.update(fields)\n    return entry\n\n\ndef iter_entries(source):\n    \"\"\"Return a list of entries from a store dict or an iterable of entries.\"\"\"\n    if source is None:\n        return []\n    if isinstance(source, dict):\n        return list(source.get(\"entries\", []))\n    return list(source)\n\n\ndef compute_next_id(entries):\n    \"\"\"Return one past the largest existing entry id (1 when empty).\"\"\"\n    max_id = 0\n    for e in entries or []:\n        try:\n            v = int(e.get(\"id\", 0))\n        except (TypeError, ValueError, AttributeError):\n            continue\n        if v > max_id:\n            max_id = v\n    return max_id + 1\n```\n\n# FILE: spend/core.py\n```python\n\"\"\"Entry CRUD and filtering over an in-memory store dict.\"\"\"\nfrom . import money\nfrom .config import SCHEMA_VERSION\nfrom .models import iter_entries\n\n__all__ = [\n    \"add_entry\",\n    \"delete_entry\",\n    \"edit_entry\",\n    \"filter_entries\",\n    \"find_entry\",\n]\n\n\ndef _ensure(store):\n    if not isinstance(store, dict):\n        raise TypeError(\"store must be a dict\")\n    store.setdefault(\"schema_version\", SCHEMA_VERSION)\n    store.setdefault(\"next_id\", 1)\n    store.setdefault(\"entries\", [])\n    return store\n\n\ndef _coerce_cents(amount):\n    if isinstance(amount, bool):\n        return int(amount)\n    if isinstance(amount, int):\n        return amount\n    return money.parse_amount(amount)\n\n\ndef add_entry(store, amount=0, description=\"\", **fields):\n    \"\"\"Append a new entry, assigning the next stable monotonic id.\"\"\"\n    _ensure(store)\n    entry_id = int(store[\"next_id\"])\n    store[\"next_id\"] = entry_id + 1\n    entry = {\n        \"id\": entry_id,\n        \"amount\": _coerce_cents(amount),\n        \"description\": description,\n    }\n    entry.update(fields)\n    store[\"entries\"].append(entry)\n    return entry\n\n\ndef find_entry(store, entry_id):\n    \"\"\"Return the entry with the given id, or None.\"\"\"\n    _ensure(store)\n    for e in store[\"entries\"]:\n        if e.get(\"id\") == entry_id:\n            return e\n    try:\n        target = int(entry_id)\n    except (TypeError, ValueError):\n        return None\n    for e in store[\"entries\"]:\n        if e.get(\"id\") == target:\n            return e\n    return None\n\n\ndef delete_entry(store, entry_id):\n    \"\"\"Remove and return the matching entry, or None if not found.\"\"\"\n    _ensure(store)\n    entry = find_entry(store, entry_id)\n    if entry is None:\n        return None\n    store[\"entries\"].remove(entry)\n    return entry\n\n\ndef edit_entry(store, entry_id, **changes):\n    \"\"\"Update only the given fields on the matching entry; return it or None.\"\"\"\n    _ensure(store)\n    entry = find_entry(store, entry_id)\n    if entry is None:\n        return None\n    if \"amount\" in changes:\n        changes[\"amount\"] = _coerce_cents(changes[\"amount\"])\n    changes.pop(\"id\", None)\n    entry.update(changes)\n    return entry\n\n\ndef filter_entries(source, predicate=None, **criteria):\n    \"\"\"Return entries matching an optional predicate and all keyword criteria.\n\n    Accepts a store dict or a plain iterable of entries.\n    \"\"\"\n    out = []\n    for e in iter_entries(source):\n        if predicate is not None and not predicate(e):\n            continue\n        if any(e.get(k) != v for k, v in criteria.items()):\n            continue\n        out.append(e)\n    return out\n```\n\n# FILE: spend/storage.py\n```python\n\"\"\"Persistence: schema-versioned save/load, migration, and single-level undo.\"\"\"\nimport copy\nimport json\nimport os\n\nfrom .config import SCHEMA_VERSION\nfrom .models import new_store, compute_next_id\n\n__all__ = [\"save\", \"load\", \"migrate\", \"snapshot\", \"restore_undo\"]\n\n_UNDO = None\n_HAS_UNDO = False\n\n\ndef migrate(data):\n    \"\"\"Migrate a prior-version store payload to the current schema.\n\n    Accepts a bare list of entries (oldest form) or a versioned dict. Preserves\n    the original entries, derives ``next_id`` when missing, and stamps the\n    current ``schema_version``. Raises ``ValueError`` for unknown versions.\n    \"\"\"\n    if isinstance(data, list):\n        data = {\"schema_version\": 1, \"entries\": list(data)}\n    if not isinstance(data, dict):\n        raise ValueError(\"unrecognized store format\")\n\n    version = data.get(\"schema_version\", 1)\n\n    if version == SCHEMA_VERSION:\n        entries = data.get(\"entries\") or []\n        data[\"entries\"] = entries\n        if not isinstance(data.get(\"next_id\"), int):\n            data[\"next_id\"] = compute_next_id(entries)\n        data[\"schema_version\"] = SCHEMA_VERSION\n        return data\n\n    if version == 1:\n        entries = data.get(\"entries\") or []\n        data[\"entries\"] = entries\n        if not isinstance(data.get(\"next_id\"), int):\n            data[\"next_id\"] = compute_next_id(entries)\n        data[\"schema_version\"] = SCHEMA_VERSION\n        return data\n\n    raise ValueError(\"unknown schema version: %r\" % (version,))\n\n\ndef _write(store, path):\n    directory = os.path.dirname(os.path.abspath(path))\n    if directory and not os.path.isdir(directory):\n        os.makedirs(directory, exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(store, f, indent=2)\n\n\ndef save(store, path):\n    \"\"\"Serialize the store to ``path`` as JSON, recording prior state for undo.\"\"\"\n    global _UNDO, _HAS_UNDO\n\n    if os.path.exists(path):\n        try:\n            prior = dict(load(path))\n        except Exception:\n            prior = dict(new_store())\n    else:\n        prior = dict(new_store())\n    _UNDO = copy.deepcopy(prior)\n    _HAS_UNDO = True\n\n    if isinstance(store, dict):\n        store.setdefault(\"entries\", [])\n        if not isinstance(store.get(\"next_id\"), int):\n            store[\"next_id\"] = compute_next_id(store.get(\"entries\", []))\n        store[\"schema_version\"] = SCHEMA_VERSION\n\n    _write(store, path)\n    return path\n\n\ndef load(path):\n    \"\"\"Load and migrate the store at ``path``; a fresh store if it is absent.\"\"\"\n    if not os.path.exists(path):\n        return new_store()\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        data = json.load(f)\n    return migrate(data)\n\n\ndef snapshot(source=None):\n    \"\"\"Record a deep copy of the current state for single-level undo.\n\n    ``source`` may be a store dict, a path string (the file's current state is\n    captured), or None (an empty store).\n    \"\"\"\n    global _UNDO, _HAS_UNDO\n    if isinstance(source, str):\n        if os.path.exists(source):\n            data = dict(load(source))\n        else:\n            data = dict(new_store())\n    elif isinstance(source, dict):\n        data = copy.deepcopy(dict(source))\n    else:\n        data = dict(new_store())\n    _UNDO = copy.deepcopy(data)\n    _HAS_UNDO = True\n    return copy.deepcopy(_UNDO)\n\n\ndef restore_undo(target=None):\n    \"\"\"Restore the last recorded state (single level).\n\n    If ``target`` is a path string, the prior state is written back to that file\n    and returned. If ``target`` is a store dict, it is restored in place and\n    returned. With no target, a copy of the prior state is returned. Returns\n    None when there is nothing to undo.\n    \"\"\"\n    global _UNDO, _HAS_UNDO\n    if not _HAS_UNDO or _UNDO is None:\n        return None\n\n    if isinstance(target, str):\n        data = copy.deepcopy(_UNDO)\n        _write(data, target)\n        return data\n\n    if isinstance(target, dict):\n        target.clear()\n        target.update(copy.deepcopy(_UNDO))\n        return target\n\n    return copy.deepcopy(_UNDO)\n```\n\n# FILE: spend/summary.py\n```python\n\"\"\"Aggregate summaries over a store's entries.\"\"\"\nfrom .models import iter_entries\n\n__all__ = [\"summarize\"]\n\n\ndef summarize(source):\n    \"\"\"Summarize entries: grand total, count, and partitions by category/tag.\n\n    Accepts a store dict or a plain iterable of entries. ``by_category`` and\n    ``by_tag`` map each label to its summed amount in cents, so each partition's\n    values sum to the grand total.\n    \"\"\"\n    entries = iter_entries(source)\n\n    total = 0\n    count = 0\n    by_category = {}\n    by_tag = {}\n\n    for e in entries:\n        amount = int(e.get(\"amount\", 0) or 0)\n        total += amount\n        count += 1\n\n        category = e.get(\"category\")\n        if category is None or category == \"\":\n            category = \"uncategorized\"\n        by_category[category] = by_category.get(category, 0) + amount\n\n        tag = e.get(\"tag\")\n        if tag is None or tag == \"\":\n            tag = \"untagged\"\n        by_tag[tag] = by_tag.get(tag, 0) + amount\n\n    return {\n        \"total\": total,\n        \"count\": count,\n        \"by_category\": by_category,\n        \"by_tag\": by_tag,\n    }\n```\n\n# FILE: spend/csvexport.py\n```python\n\"\"\"CSV export for spend entries.\"\"\"\nimport csv\n\nfrom . import money\nfrom .models import iter_entries\n\n__all__ = [\"HEADER\", \"write_csv\"]\n\nHEADER = (\"id\", \"amount\", \"description\", \"category\", \"tag\")\n\n\ndef _row(entry):\n    row = []\n    for col in HEADER:\n        if col == \"amount\":\n            row.append(money.format_cents(int(entry.get(\"amount\", 0) or 0)))\n        else:\n            value = entry.get(col, \"\")\n            row.append(\"\" if value is None else value)\n    return row\n\n\ndef write_csv(source, target):\n    \"\"\"Write entries from ``source`` to ``target`` (a path or file-like object).\n\n    The first row is :data:`HEADER`; amounts are rendered with\n    :func:`spend.money.format_cents`.\n    \"\"\"\n    entries = iter_entries(source)\n\n    if hasattr(target, \"write\"):\n        writer = csv.writer(target)\n        writer.writerow(list(HEADER))\n        for e in entries:\n            writer.writerow(_row(e))\n        return target\n\n    with open(target, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n        writer = csv.writer(f)\n        writer.writerow(list(HEADER))\n        for e in entries:\n            writer.writerow(_row(e))\n    return target\n```\n\n# FILE: spend/cli.py\n```python\n\"\"\"Command-line interface for the spend package.\"\"\"\nimport argparse\nimport sys\n\nfrom . import config, core, money, storage, summary, csvexport\n\n__all__ = [\"main\", \"build_parser\"]\n\n\ndef build_parser():\n    parser = argparse.ArgumentParser(prog=config.APP_NAME, description=\"Track spending.\")\n    parser.add_argument(\"--file\", \"-f\", default=None, help=\"Path to the store file.\")\n    sub = parser.add_subparsers(dest=\"command\")\n\n    p_add = sub.add_parser(\"add\", help=\"Add an entry.\")\n    p_add.add_argument(\"amount\")\n    p_add.add_argument(\"description\", nargs=\"?\", default=\"\")\n    p_add.add_argument(\"--category\", \"-c\", default=None)\n    p_add.add_argument(\"--tag\", \"-t\", default=None)\n\n    sub.add_parser(\"list\", help=\"List entries.\")\n\n    p_del = sub.add_parser(\"delete\", help=\"Delete an entry by id.\")\n    p_del.add_argument(\"id\", type=int)\n\n    p_edit = sub.add_parser(\"edit\", help=\"Edit an entry by id.\")\n    p_edit.add_argument(\"id\", type=int)\n    p_edit.add_argument(\"--amount\", default=None)\n    p_edit.add_argument(\"--description\", default=None)\n    p_edit.add_argument(\"--category\", default=None)\n    p_edit.add_argument(\"--tag\", default=None)\n\n    sub.add_parser(\"summary\", help=\"Show a summary.\")\n    sub.add_parser(\"undo\", help=\"Undo the last change.\")\n\n    p_csv = sub.add_parser(\"export\", help=\"Export entries to CSV.\")\n    p_csv.add_argument(\"path\")\n\n    return parser\n\n\ndef _path(args):\n    return args.file or config.default_path()\n\n\ndef main(argv=None):\n    if argv is None:\n        argv = sys.argv[1:]\n    parser = build_parser()\n    args = parser.parse_args(argv)\n\n    if not args.command:\n        parser.print_help()\n        return 0\n\n    path = _path(args)\n\n    if args.command == \"add\":\n        store = storage.load(path)\n        fields = {}\n        if args.category is not None:\n            fields[\"category\"] = args.category\n        if args.tag is not None:\n            fields[\"tag\"] = args.tag\n        entry = core.add_entry(store, args.amount, args.description, **fields)\n        storage.save(store, path)\n        print(\"added #%d %s\" % (entry[\"id\"], money.format_cents(entry[\"amount\"])))\n        return 0\n\n    if args.command == \"list\":\n        store = storage.load(path)\n        for e in store[\"entries\"]:\n            print(\"#%d %s %s\" % (e[\"id\"], money.format_cents(e[\"amount\"]),\n                                 e.get(\"description\", \"\")))\n        return 0\n\n    if args.command == \"delete\":\n        store = storage.load(path)\n        entry = core.delete_entry(store, args.id)\n        if entry is None:\n            print(\"no such entry: %d\" % args.id, file=sys.stderr)\n            return 1\n        storage.save(store, path)\n        print(\"deleted #%d\" % args.id)\n        return 0\n\n    if args.command == \"edit\":\n        store = storage.load(path)\n        changes = {}\n        if args.amount is not None:\n            changes[\"amount\"] = args.amount\n        if args.description is not None:\n            changes[\"description\"] = args.description\n        if args.category is not None:\n            changes[\"category\"] = args.category\n        if args.tag is not None:\n            changes[\"tag\"] = args.tag\n        entry = core.edit_entry(store, args.id, **changes)\n        if entry is None:\n            print(\"no such entry: %d\" % args.id, file=sys.stderr)\n            return 1\n        storage.save(store, path)\n        print(\"edited #%d\" % args.id)\n        return 0\n\n    if args.command == \"summary\":\n        store = storage.load(path)\n        result = summary.summarize(store)\n        print(\"total %s over %d entries\" %\n              (money.format_cents(result[\"total\"]), result[\"count\"]))\n        return 0\n\n    if args.command == \"undo\":\n        result = storage.restore_undo(path)\n        if result is None:\n            print(\"nothing to undo\", file=sys.stderr)\n            return 1\n        print(\"undone\")\n        return 0\n\n    if args.command == \"export\":\n        store = storage.load(path)\n        csvexport.write_csv(store, args.path)\n        print(\"exported to %s\" % args.path)\n        return 0\n\n    parser.print_help()\n    return 0\n```", "summary": "1 error"}